---
import '../styles/global.css';
const { title = 'MAJO Codex', desc = 'A fan compendium of witches, skills, and combat data.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Inter:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="masthead">
    <div class="wrap">
      <a class="brand" href={base}>
        <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M2 12 C6 5.5, 18 5.5, 22 12 C18 18.5, 6 18.5, 2 12 Z" fill="none" stroke="var(--sigil)" stroke-width="1.4"/>
          <circle cx="12" cy="12" r="4.2" fill="none" stroke="var(--sigil)" stroke-width="1.4"/>
          <circle cx="12" cy="12" r="1.4" fill="var(--sigil)"/>
        </svg>
        <span class="name">MAJO <b>CODEX</b></span>
      </a>
      <nav>
        <a href={base}>Witches</a>
        <a href={base + 'tier'}>Training Boss</a>
        <a href={base + 'codes'}>Codes</a>
        <a class="nav-immersive" href={base + 'immersive.html'}>Immersive</a>
      </nav>
    </div>
  </header>
  <main>
    <slot />
  </main>
  <footer class="site">
    <div class="wrap">
      <span>MAJO Codex — an unofficial fan compendium. Game data © its respective owners.</span>
      <span class="mono">23 witches indexed</span>
    </div>
  </footer>
</body>
</html>
