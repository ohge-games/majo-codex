---
import Base from '../../layouts/Base.astro';
import EyeBadge from '../../components/EyeBadge.astro';
import witches from '../../data/witches.json';
import abilities from '../../data/abilities.json';
import skills from '../../data/skills.json';
import classBase from '../../data/class_base_stats.json';
import constants from '../../data/constants.json';
import fs from 'node:fs';

export async function getStaticPaths() {
  const witches = (await import('../../data/witches.json')).default;
  return witches.map(w => ({ params: { id: w.witch_id.toLowerCase() }, props: { witch: w } }));
}

const { witch } = Astro.props;
const base = import.meta.env.BASE_URL;
const cap = s => s ? s[0].toUpperCase() + s.slice(1) : s;
const lc = s => (s ?? '').toLowerCase();
const ui = name => `${base}img/ui/${name}.png`;
const hasImg = p => { try { return fs.existsSync(`${process.cwd()}/public${p}`); } catch { return false; } };
const hasUi = name => hasImg(`/img/ui/${name}.png`);

const SLOT_ORDER = ['Extreme', 'Special', 'Normal', 'Class', 'Passive', 'Interference'];
const wSkills = skills.filter(s => s.witch_id === witch.witch_id)
  .sort((a, b) => SLOT_ORDER.indexOf(a.slot) - SLOT_ORDER.indexOf(b.slot));
const wAbil = abilities.filter(a => a.witch_id === witch.witch_id && (a.variant ?? 'base') === 'base');
const abilBySlot = Object.fromEntries(wAbil.map(a => [String(a.slot).toLowerCase(), a]));
const penalty = constants.find(c => c.key === 'weakness_penalty')?.value ?? -25;

function frames(slot) {
  const a = abilBySlot[slot.toLowerCase()];
  if (!a) return null;
  const p = [];
  if (a.hit_count) p.push(`${a.hit_count} hit${a.hit_count > 1 ? 's' : ''}`);
  if (a.total_damage_pct) p.push(`${a.total_damage_pct}% dmg`);
  if (a.cooldown_s) p.push(`${a.cooldown_s}s CD`);
  if (a.charge_cost) p.push(`${a.charge_cost} charge`);
  if (a.range) p.push(`range ${a.range}`);
  if (a.total_stagger) p.push(`${a.total_stagger} stagger`);
  return p.length ? p : null;
}

// tags aggregated from ability data (matches in-game tag chips)
const humanize = s => s.replace(/([a-z])([A-Z])/g, '$1 $2').replace(/_/g, ' ').trim();
const rawTags = wAbil.flatMap(a => (a.tags ? String(a.tags).split(';') : []));
const tags = [...new Set(rawTags.map(t => t.trim()).filter(Boolean))].map(humanize);

// class combat profile (shared by class)
const TRAIT = [['dodge_val', 'Dodge'], ['dodge_cd', 'Dodge CD'], ['block_dmg_reduction', 'Block Reduction'],
               ['posture', 'Posture'], ['stagger_value', 'Stagger'], ['knockback_res', 'Knockback Res']];
const cbs = Object.fromEntries(classBase.filter(r => r.class === witch.class).map(r => [r.attribute_id, r.base_value]));
const traits = TRAIT.filter(([k]) => k in cbs).map(([k, label]) => [label, cbs[k]]);

// art
const heroSrc = hasImg(`/img/hero/${witch.portrait_filename}`) ? `${base}img/hero/${witch.portrait_filename}`
             : hasImg(`/img/card/${witch.portrait_filename}`) ? `${base}img/card/${witch.portrait_filename}` : null;
const stars = [1, 2, 3, 4, 5, 6];
---
<Base title={`${witch.name} — MAJO Codex`} desc={witch.title || `${witch.rarity} ${witch.class}`}>
  <a class="back mono" href={base}>&larr; All witches</a>

  <article class={`witch rar-${witch.rarity}`}>
    <section class="hero">
      {heroSrc && <div class="hero-bg" style={`background-image:url(${heroSrc})`}></div>}
      <div class="hero-inner wrap">
        <div class="portrait-col">
          <div class="portrait-frame">
            {heroSrc ? (
              <img class="hero-img" src={heroSrc} alt={witch.name} width="293" height="512" />
            ) : (
              <svg viewBox="0 0 24 24" class="sigil" aria-hidden="true">
                <path d="M2 12 C6 5.5, 18 5.5, 22 12 C18 18.5, 6 18.5, 2 12 Z" fill="none" stroke="currentColor" stroke-width=".8"/>
                <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width=".8"/>
                <circle cx="12" cy="12" r="1.2" fill="currentColor"/>
              </svg>
            )}
            <span class="pid mono">{witch.witch_id}</span>
          </div>
          <div class="rank" title="Max rank 6★">
            {stars.map(i => (
              hasUi(i <= 3 ? 'star_red' : 'star_yellow')
                ? <img class="star" src={ui(i <= 3 ? 'star_red' : 'star_yellow')} alt="" width="18" height="18" />
                : <span class={`star-glyph ${i <= 3 ? 'lo' : 'hi'}`}>★</span>
            ))}
            <span class="rank-cap mono">max</span>
          </div>
        </div>

        <div class="info-col">
          <div class="rarity-row">
            {hasUi(`rarity_${lc(witch.rarity)}`)
              ? <img class="rarity-lg" src={ui(`rarity_${lc(witch.rarity)}`)} alt={witch.rarity} height="30" />
              : <span class={`rarity-chip is-${witch.rarity}`}>{witch.rarity}</span>}
            {witch.title && <span class="title eyebrow">{witch.title}</span>}
          </div>
          <h1 class="wname display">{witch.name}</h1>

          <div class="class-row">
            <div class="crest">
              {hasUi('class_background') && <img class="crest-bg" src={ui('class_background')} alt="" />}
              {hasUi(`class_${lc(witch.class)}`)
                ? <img class="crest-ic" src={ui(`class_${lc(witch.class)}`)} alt={witch.class} />
                : <span class="crest-fallback">{witch.class[0]}</span>}
            </div>
            <div class="class-meta">
              <span class="clabel mono">Class</span>
              <span class="cname">{witch.class}</span>
            </div>
          </div>

          <div class="type-row">
            <span class="tchip">
              {hasUi(`type_${lc(witch.damage_type)}`)
                ? <img class="tic" src={ui(`type_${lc(witch.damage_type)}`)} alt="" width="22" height="22" />
                : <EyeBadge type={witch.damage_type} size={22} title="" />}
              <span><b>{cap(witch.damage_type)}</b> Attack</span>
            </span>
            <span class="tchip weak">
              {hasUi(`type_${lc(witch.weakness_type)}`)
                ? <img class="tic" src={ui(`type_${lc(witch.weakness_type)}`)} alt="" width="22" height="22" />
                : <EyeBadge type={witch.weakness_type} size={22} title="" />}
              <span><b>{cap(witch.weakness_type)}</b> Weakness <span class="pen mono">{penalty}%</span></span>
            </span>
          </div>

          {tags.length > 0 && (
            <div class="tags">
              {tags.map(t => <span class="tag">{t}</span>)}
            </div>
          )}
          {witch.atk_spd && <div class="atkspd mono">ATK SPD {witch.atk_spd}</div>}
        </div>
      </div>
    </section>

    <div class="wrap body">
      <section class="panel">
        <h2 class="sec display">Skills</h2>
        <div class="skills">
          {wSkills.map(s => {
            const fr = frames(s.slot);
            const nm = (s.name && s.name !== 'None' && s.name !== witch.name) ? s.name : `${s.slot} Skill`;
            return (
            <article class="skill">
              <div class="skill-head">
                {hasImg(`/img/skill/${witch.witch_id.toLowerCase()}_${s.slot.toLowerCase()}.png`) && (
                  <img class="skill-icon" src={`${base}img/skill/${witch.witch_id.toLowerCase()}_${s.slot.toLowerCase()}.png`} alt="" width="38" height="38" loading="lazy" />
                )}
                <span class={`slot slot-${s.slot.toLowerCase()}`}>{s.slot}</span>
                <h3>{nm}</h3>
                {s.has_plus === 'yes' && (
                  hasUi('skill_plus')
                    ? <img class="plus-ic" src={ui('skill_plus')} alt="Skill+" title={`Plus unlocks at ${s.plus_unlocks_at_star ?? '?'}★`} height="20" />
                    : <span class="plus" title={`Plus unlocks at ${s.plus_unlocks_at_star ?? '?'}★`}>PLUS</span>
                )}
              </div>
              {s.description && <p class="desc">{s.description}</p>}
              {fr && <p class="frames mono">{fr.join('  ·  ')}</p>}
              {!fr && s.mechanics && <p class="frames mono">{s.mechanics}</p>}
              {s.has_plus === 'yes' && s.plus_description &&
                <p class="plus-desc"><span class="plus-tag mono">+ {s.plus_unlocks_at_star ?? ''}★</span> {s.plus_description}</p>}
            </article>
          )})}
        </div>
      </section>

      {traits.length > 0 && (
        <section class="panel">
          <h2 class="sec display">Class combat profile <span class="sec-note mono">shared by {witch.class}</span></h2>
          <div class="traits">
            {traits.map(([label, val]) => (
              <div class="trait"><span class="k mono">{label}</span><span class="v">{val}</span></div>
            ))}
          </div>
          <p class="note mono">HP / ATK / DEF scale by class &amp; rarity and arrive with the level-scaling pass. Resistances are flat; the only per-witch deviation is the {penalty}% {cap(witch.weakness_type)} weakness above.</p>
        </section>
      )}
    </div>
  </article>
</Base>

<style>
  .back{display:inline-block;color:var(--ink-dim);font-size:.8rem;padding:20px 24px 0;max-width:var(--maxw);margin:0 auto;width:100%}
  .back:hover{color:var(--ink)}
  .rar-SR{--rc:var(--sr)} .rar-SSR{--rc:var(--ssr)} .rar-UR{--rc:var(--ur)}

  /* hero */
  .hero{position:relative;overflow:hidden;border-bottom:1px solid var(--line);margin-top:8px}
  .hero-bg{position:absolute;inset:0;background-size:cover;background-position:center 18%;
    filter:blur(30px) brightness(.5) saturate(1.3);transform:scale(1.08);opacity:.78;z-index:0}
  .hero::after{content:"";position:absolute;inset:0;z-index:0;
    background:linear-gradient(180deg,rgba(12,10,21,.18),rgba(12,10,21,.72)),
               radial-gradient(720px 340px at 18% -20%, color-mix(in srgb,var(--rc) 26%,transparent), transparent 70%)}
  .hero-inner{position:relative;z-index:1;display:grid;grid-template-columns:290px 1fr;gap:38px;
    align-items:center;padding:38px 24px 42px}

  .portrait-col{display:flex;flex-direction:column;gap:12px}
  .portrait-frame{position:relative;aspect-ratio:293/512;border-radius:16px;overflow:hidden;
    border:1px solid color-mix(in srgb,var(--rc) 50%,var(--line));background:linear-gradient(160deg,var(--veil-2),#0e0b1a);
    color:var(--rc);display:grid;place-items:center;
    box-shadow:0 20px 60px -18px rgba(0,0,0,.8), 0 0 40px -20px var(--rc)}
  .hero-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:top center}
  .portrait-frame .sigil{width:42%;opacity:.5}
  .pid{position:absolute;bottom:10px;right:12px;font-size:.66rem;color:var(--ink-faint);
    background:rgba(12,10,21,.6);padding:1px 6px;border-radius:5px}
  .rank{display:flex;align-items:center;justify-content:center;gap:4px}
  .star{width:18px;height:18px;object-fit:contain}
  .star-glyph{font-size:16px;line-height:1}
  .star-glyph.lo{color:#e0574b} .star-glyph.hi{color:var(--ssr)}
  .rank-cap{font-size:.6rem;color:var(--ink-faint);margin-left:5px;letter-spacing:.14em;text-transform:uppercase}

  .info-col{min-width:0}
  .rarity-row{display:flex;align-items:center;gap:12px;margin-bottom:8px}
  .rarity-lg{height:30px;width:auto;object-fit:contain}
  .title{margin:0}
  .info-col h1{font-size:clamp(2.2rem,5vw,3.4rem);margin:.05em 0 .5em}

  .class-row{display:flex;align-items:center;gap:12px;margin-bottom:16px}
  .crest{position:relative;width:60px;height:60px;display:grid;place-items:center;flex-shrink:0}
  .crest-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:contain}
  .crest-ic{position:relative;width:74%;height:74%;object-fit:contain;z-index:1}
  .crest-fallback{position:relative;z-index:1;font-family:"Cinzel",serif;font-size:1.4rem;color:var(--ink)}
  .class-meta{display:flex;flex-direction:column;line-height:1.2}
  .clabel{font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;color:var(--ink-faint)}
  .cname{font-size:1.15rem;color:var(--ink);font-weight:600}

  .type-row{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:16px}
  .tchip{display:inline-flex;align-items:center;gap:9px;background:rgba(20,16,32,.7);
    border:1px solid var(--line);border-radius:10px;padding:8px 13px;font-size:.92rem;color:var(--ink-dim)}
  .tchip b{color:var(--ink)}
  .tchip .tic{width:22px;height:22px;object-fit:contain;border-radius:5px}
  .tchip.weak .tic{box-shadow:0 0 0 2px #e0574b, 0 0 7px -1px rgba(224,87,75,.7)}
  .pen{color:var(--physical);font-size:.8rem;margin-left:2px}

  .tags{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:14px}
  .tag{font-family:"Space Mono",monospace;font-size:.68rem;letter-spacing:.06em;color:var(--ink-dim);
    background:var(--veil);border:1px solid var(--line);border-radius:999px;padding:4px 11px}
  .atkspd{font-size:.78rem;color:var(--ink-faint);letter-spacing:.1em}

  /* body panels */
  .body{padding-top:8px}
  .sec{font-size:1.5rem;margin:44px 0 18px;display:flex;align-items:baseline;gap:12px}
  .sec-note{font-size:.72rem;color:var(--ink-faint);font-weight:400;letter-spacing:.08em}
  .skills{display:grid;gap:14px;grid-template-columns:repeat(auto-fill,minmax(340px,1fr))}
  .skill{background:var(--veil);border:1px solid var(--line);border-radius:var(--r);padding:16px 18px}
  .skill-head{display:flex;align-items:center;gap:10px;margin-bottom:8px}
  .skill-icon{border-radius:8px;background:var(--nightshade);border:1px solid var(--line);flex-shrink:0}
  .skill-head h3{font-size:1.05rem;margin:0;font-weight:600}
  .slot{font-family:"Space Mono",monospace;font-size:.6rem;letter-spacing:.12em;text-transform:uppercase;
    padding:3px 8px;border-radius:6px;border:1px solid var(--line);color:var(--ink-dim);white-space:nowrap}
  .slot-extreme{color:var(--ssr);border-color:color-mix(in srgb,var(--ssr) 45%,var(--line))}
  .slot-special{color:var(--sigil);border-color:color-mix(in srgb,var(--sigil) 45%,var(--line))}
  .slot-interference{color:var(--magic);border-color:color-mix(in srgb,var(--magic) 40%,var(--line))}
  .plus{margin-left:auto;font-family:"Space Mono",monospace;font-size:.58rem;font-weight:700;letter-spacing:.14em;
    color:var(--ssr);border:1px solid color-mix(in srgb,var(--ssr) 50%,var(--line));border-radius:6px;padding:2px 7px}
  .plus-ic{margin-left:auto;height:20px;width:auto;object-fit:contain}
  .desc{color:var(--ink-dim);font-size:.9rem;margin:0 0 10px}
  .frames{font-size:.76rem;color:var(--ink-faint);background:var(--nightshade);border:1px solid var(--line);
    border-radius:7px;padding:7px 10px;margin:0;word-break:break-word}
  .plus-desc{font-size:.85rem;color:var(--ink-dim);margin:10px 0 0;padding-top:10px;border-top:1px dashed var(--line)}
  .plus-tag{color:var(--ssr);font-size:.7rem;margin-right:4px}

  .traits{display:grid;gap:8px;grid-template-columns:repeat(auto-fill,minmax(160px,1fr))}
  .trait{display:flex;justify-content:space-between;gap:10px;background:var(--veil);
    border:1px solid var(--line);border-radius:8px;padding:9px 12px}
  .trait .k{font-size:.72rem;color:var(--ink-faint)}
  .trait .v{font-weight:600}
  .note{color:var(--ink-faint);font-size:.76rem;margin-top:16px;max-width:72ch;line-height:1.6}

  @media(max-width:760px){
    .hero-inner{grid-template-columns:1fr;justify-items:center;text-align:center;gap:22px}
    .portrait-col{max-width:260px;width:100%}
    .info-col{width:100%}
    .rarity-row,.class-row,.type-row,.tags{justify-content:center}
    .skills{grid-template-columns:1fr}
  }
</style>
