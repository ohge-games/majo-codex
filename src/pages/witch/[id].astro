---
import Base from '../../layouts/Base.astro';
import EyeBadge from '../../components/EyeBadge.astro';
import SkillBox from '../../components/SkillBox.astro';
import witches from '../../data/witches.json';
import abilities from '../../data/abilities.json';
import skills from '../../data/skills.json';
import constants from '../../data/constants.json';
import tiers from '../../data/tier_synergy.json';
import scores from '../../data/skill_scores.json';
import fs from 'node:fs';

export async function getStaticPaths() {
  const witches = (await import('../../data/witches.json')).default;
  return witches.map(w => ({ params: { id: w.witch_id.toLowerCase() }, props: { witch: w } }));
}

const { witch } = Astro.props;
const base = import.meta.env.BASE_URL;
const cap = s => s ? s[0].toUpperCase() + s.slice(1) : s;
const lc = s => (s ?? '').toLowerCase();
const ui = name => `${base}img/ui/${name}.png`;
const hasImg = p => { try { return fs.existsSync(`${process.cwd()}/public${p}`); } catch { return false; } };
const hasUi = name => hasImg(`/img/ui/${name}.png`);

const penalty = constants.find(c => c.key === 'weakness_penalty')?.value ?? -25;

// skills grouped
const wSkills = skills.filter(s => s.witch_id === witch.witch_id);
const bySlot = Object.fromEntries(wSkills.map(s => [s.slot, s]));
const extreme = bySlot['Extreme'];
const mains = ['Special', 'Normal', 'Class', 'Passive'].map(sl => bySlot[sl]).filter(Boolean);
const interference = bySlot['Interference'];
const tip = (tiers.witches || []).find(t => t.witch_id === witch.witch_id) || null;
const ws = (scores.witches || {})[witch.witch_id] || { overall_by_rank: {}, skills: {} };
const scoreFor = sk => ((ws.skills || {})[`${witch.witch_id}_${sk.slot.toLowerCase()}`] || {}).by_rank || null;
const archetype = (tip && tip.synergy_note && tip.synergy_note.includes(':'))
  ? tip.synergy_note.split(':')[0].trim() : null;
const verdict = archetype ? `${archetype} — ${witch.rarity} ${witch.class}, ${cap(witch.damage_type)} damage` : null;

// tags from ability data
const wAbil = abilities.filter(a => a.witch_id === witch.witch_id && (a.variant ?? 'base') === 'base');
const humanize = s => s.replace(/([a-z])([A-Z])/g, '$1 $2').replace(/_/g, ' ').trim();
const tags = [...new Set(wAbil.flatMap(a => (a.tags ? String(a.tags).split(';') : [])).map(t => t.trim()).filter(Boolean))].map(humanize);

// rank stars
const START = { SSR: 2, SR: 3, R: 1, UR: 2 };
const baseStars = START[witch.rarity] ?? 2;
const minRank = witch.rarity === 'SSR' ? 2 : 1;
const maxRank = witch.rarity === 'SSR' ? 9 : 6;
const showEx = witch.rarity === 'SSR';
const hasStars = hasUi('star_red') && hasUi('star_yellow') && hasUi('star_grey');

// art
const heroSrc = hasImg(`/img/hero/${witch.portrait_filename}`) ? `${base}img/hero/${witch.portrait_filename}`
             : hasImg(`/img/card/${witch.portrait_filename}`) ? `${base}img/card/${witch.portrait_filename}` : null;
const heroStem = witch.portrait_filename ? witch.portrait_filename.replace(/\.[^.]+$/, '') : null;
const heroVideo = heroStem ? (['mp4','webm'].map(e => hasImg(`/img/hero/${heroStem}.${e}`) ? { ext: e, src: `${base}img/hero/${heroStem}.${e}` } : null).find(Boolean) || null) : null;
---
<Base title={`${witch.name} — MAJO Codex`} desc={witch.title || `${witch.rarity} ${witch.class}`}>
  <a class="back mono" href={base}>&larr; All witches</a>

  <article class={`witch rar-${witch.rarity}`}>
    {heroSrc && <div class="hero-bg" style={`background-image:url(${heroSrc})`}></div>}
    <div class="witch-layout wrap">
      <aside class="rail">
          <div class="portrait-frame">
            {heroVideo ? (
              <video class="hero-img" autoplay loop muted playsinline poster={heroSrc || undefined} width="293" height="512"><source src={heroVideo.src} type={`video/${heroVideo.ext}`} /></video>
            ) : heroSrc ? (
              <img class="hero-img" src={heroSrc} alt={witch.name} width="293" height="512" />
            ) : (
              <svg viewBox="0 0 24 24" class="sigil" aria-hidden="true">
                <path d="M2 12 C6 5.5, 18 5.5, 22 12 C18 18.5, 6 18.5, 2 12 Z" fill="none" stroke="currentColor" stroke-width=".8"/>
                <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width=".8"/>
                <circle cx="12" cy="12" r="1.2" fill="currentColor"/>
              </svg>
            )}
          </div>
          <div class="rank" id="rank" data-base={baseStars} data-min={minRank} data-max={maxRank} data-uibase={`${base}img/ui/`}>
            {[1, 2, 3, 4, 5, 6].map(i => (
              <button class="star" data-pos={i} type="button" aria-label={`Rank ${i}`}>
                {hasStars
                  ? <img class="star-img" src={ui(i <= baseStars ? (baseStars >= 4 ? 'star_yellow' : 'star_red') : 'star_grey')} alt="" width="20" height="20" />
                  : <span class="star-glyph" data-kind={i <= baseStars ? (baseStars >= 4 ? 'yellow' : 'red') : 'grey'}>★</span>}
              </button>
            ))}
            {showEx && <span class="ex-sep"></span>}
            {showEx && [1, 2, 3].map(n => (
              <button class="exstar" data-pos={6 + n} type="button" aria-label={`EX${n}`}>
                {hasUi(`star_ex${n}`) ? <img class="ex-img" src={ui(`star_ex${n}`)} alt={`EX${n}`} width="22" height="22" /> : <span class="ex-txt mono">EX{n}</span>}
              </button>
            ))}
          </div>
          <p class="rank-hint mono">Click stars to set rank · plus skills unlock as you promote</p>
          <div class="dps-overall" data-overall={JSON.stringify(ws.overall_by_rank || {})}>
            <span class="dps-label mono">Est. DPS score</span>
            <span class="dps-val">{(ws.overall_by_rank || {})[String(baseStars)] ?? '—'}</span>
            <span class="dps-note mono">provisional · damage only</span>
          </div>
      </aside>

      <div class="main">
        <div class="info-col">
          <div class="rarity-row">
            {hasUi(`rarity_${lc(witch.rarity)}`)
              ? <img class="rarity-lg" src={ui(`rarity_${lc(witch.rarity)}`)} alt={witch.rarity} height="30" />
              : <span class={`rarity-chip is-${witch.rarity}`}>{witch.rarity}</span>}
            {witch.title && <span class="title eyebrow">{witch.title}</span>}
          </div>
          <h1 class="wname display">{witch.name}</h1>

          <div class="class-row">
            <div class="crest">
              {hasUi('class_background') && <img class="crest-bg" src={ui('class_background')} alt="" />}
              {hasUi(`class_${lc(witch.class)}`)
                ? <img class="crest-ic" src={ui(`class_${lc(witch.class)}`)} alt={witch.class} />
                : <span class="crest-fallback">{witch.class[0]}</span>}
            </div>
            <div class="class-meta">
              <span class="clabel mono">Class</span>
              <span class="cname">{witch.class}</span>
            </div>
          </div>

          <div class="type-row">
            <span class="tchip">
              {hasUi(`type_${lc(witch.damage_type)}`)
                ? <img class="tic" src={ui(`type_${lc(witch.damage_type)}`)} alt="" width="22" height="22" />
                : <EyeBadge type={witch.damage_type} size={22} title="" />}
              <span><b>{cap(witch.damage_type)}</b> Attack</span>
            </span>
            <span class="tchip weak">
              {hasUi(`type_${lc(witch.weakness_type)}`)
                ? <img class="tic" src={ui(`type_${lc(witch.weakness_type)}`)} alt="" width="22" height="22" />
                : <EyeBadge type={witch.weakness_type} size={22} title="" />}
              <span><b>{cap(witch.weakness_type)}</b> Weakness <span class="pen mono">{penalty}%</span></span>
            </span>
          </div>

          {tags.length > 0 && <div class="tags">{tags.map(t => <span class="tag">{t}</span>)}</div>}
          {witch.atk_spd && <div class="atkspd mono">ATK SPD {witch.atk_spd}</div>}
        </div>

      {verdict && <p class="verdict">{verdict}</p>}

      {tip && (
        <section class="deploy">
          <h2 class="sec display">How to deploy</h2>
          <div class="deploy-grid">
            <div class="deploy-card">
              <span class="dl mono">How she plays</span>
              <p>{tip.synergy_note}</p>
            </div>
            {tip.interference && tip.interference.name && (
              <div class="deploy-card">
                <span class="dl mono">Interference — who to slot her behind</span>
                <p><b>{tip.interference.name}.</b> {tip.interference.effect}</p>
                {tip.interference.role_match && <p class="fit">Best behind: <b>{tip.interference.role_match}</b></p>}
              </div>
            )}
            {tip.clusters && tip.clusters.length > 0 && (
              <div class="deploy-card">
                <span class="dl mono">Team synergy</span>
                <div class="dchips">{tip.clusters.map(c => <span class="dchip">{c === 'downer' ? 'stagger' : c === 'hard-taunt' ? 'taunt' : c}</span>)}</div>
                <p class="hint">Synergy clusters she belongs to — pair with members that complete the loop. Matchups vs. specific bosses live on the <a href={base + 'tier'}>Tier List</a>.</p>
              </div>
            )}
          </div>
        </section>
      )}

      <section>
        <h2 class="sec display">Skills</h2>
        {extreme && <SkillBox witch={witch} skill={extreme} hero={true} rarity={witch.rarity} baseLevel={baseStars} score={scoreFor(extreme)} />}
        <div class="skill-list">
          {mains.map(s => <SkillBox witch={witch} skill={s} rarity={witch.rarity} baseLevel={baseStars} score={scoreFor(s)} />)}
        </div>
      </section>

      {interference && (
        <section class="interference">
          <h2 class="sec display">Interference <span class="sec-note mono">support only — active when this witch backs another unit</span></h2>
          <SkillBox witch={witch} skill={interference} rarity={witch.rarity} baseLevel={baseStars} score={scoreFor(interference)} />
        </section>
      )}

    </div>
  </article>
</Base>

<style>
  .back{display:inline-block;color:var(--ink-dim);font-size:.8rem;padding:20px 24px 0;max-width:var(--maxw);margin:0 auto;width:100%}
  .back:hover{color:var(--ink)}
  .rar-SR{--rc:var(--sr)} .rar-SSR{--rc:var(--ssr)} .rar-UR{--rc:var(--ur)}

  .witch{position:relative}
  .hero-bg{position:absolute;top:0;left:0;right:0;height:440px;background-size:cover;background-position:center 18%;
    filter:blur(34px) brightness(.5) saturate(1.3);transform:scale(1.08);opacity:.6;z-index:0}
  .witch::before{content:"";position:absolute;top:0;left:0;right:0;height:440px;z-index:0;pointer-events:none;
    background:linear-gradient(180deg,rgba(12,10,21,.12),var(--bg) 94%),
               radial-gradient(720px 340px at 15% -10%, color-mix(in srgb,var(--rc) 22%,transparent), transparent 70%)}
  .witch-layout{position:relative;z-index:1;display:grid;grid-template-columns:300px 1fr;gap:34px;align-items:start;padding-top:24px;padding-bottom:56px}
  .rail{position:sticky;top:76px;align-self:start;display:flex;flex-direction:column;gap:12px}
  .dps-overall{display:flex;flex-direction:column;align-items:center;gap:2px;padding:10px 12px;
    background:linear-gradient(180deg,color-mix(in srgb,var(--ssr) 10%,var(--veil)),var(--veil));
    border:1px solid color-mix(in srgb,var(--ssr) 34%,var(--line));border-radius:var(--r)}
  .dps-overall .dps-label{font-size:.6rem;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-faint)}
  .dps-overall .dps-val{font-size:1.8rem;font-weight:800;color:var(--ssr);line-height:1}
  .dps-overall .dps-note{font-size:.56rem;color:var(--ink-faint);letter-spacing:.04em}
  .main{min-width:0}
  .portrait-frame{position:relative;aspect-ratio:293/512;height:min(58vh,520px);width:auto;margin:0 auto;border-radius:16px;overflow:hidden;
    border:1px solid color-mix(in srgb,var(--rc) 50%,var(--line));background:linear-gradient(160deg,var(--veil-2),#0e0b1a);
    color:var(--rc);display:grid;place-items:center;box-shadow:0 20px 60px -18px rgba(0,0,0,.8), 0 0 40px -20px var(--rc)}
  .hero-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:top center}
  .portrait-frame .sigil{width:42%;opacity:.5}
  .rank{display:flex;align-items:center;justify-content:center;gap:3px;flex-wrap:wrap}
  .star,.exstar{background:none;border:none;cursor:pointer;padding:2px;display:flex;line-height:0}
  .star-img,.ex-img{width:20px;height:20px;object-fit:contain}
  .star-glyph{font-size:18px;line-height:1}
  .star-glyph[data-kind="red"]{color:#e0574b} .star-glyph[data-kind="yellow"]{color:var(--ssr)} .star-glyph[data-kind="grey"]{color:var(--ink-faint)}
  .ex-sep{width:8px}
  .exstar{opacity:.4;transition:.15s} .exstar.on{opacity:1}
  .ex-txt{font-size:.66rem;color:var(--ink-faint);border:1px solid var(--line);border-radius:5px;padding:2px 5px}
  .exstar.on .ex-txt{color:var(--ssr);border-color:color-mix(in srgb,var(--ssr) 50%,var(--line))}
  .rank-hint{font-size:.62rem;color:var(--ink-faint);text-align:center;letter-spacing:.04em}

  .info-col{min-width:0}
  .rarity-row{display:flex;align-items:center;gap:12px;margin-bottom:8px}
  .rarity-lg{height:30px;width:auto;object-fit:contain}
  .title{margin:0}
  .info-col h1{font-size:clamp(2.2rem,5vw,3.4rem);margin:.05em 0 .5em}
  .class-row{display:flex;align-items:center;gap:12px;margin-bottom:16px}
  .crest{position:relative;width:60px;height:60px;display:grid;place-items:center;flex-shrink:0}
  .crest-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:contain}
  .crest-ic{position:relative;width:74%;height:74%;object-fit:contain;z-index:1}
  .crest-fallback{position:relative;z-index:1;font-family:"Cinzel",serif;font-size:1.4rem;color:var(--ink)}
  .class-meta{display:flex;flex-direction:column;line-height:1.2}
  .clabel{font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;color:var(--ink-faint)}
  .cname{font-size:1.15rem;color:var(--ink);font-weight:600}
  .type-row{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:16px}
  .tchip{display:inline-flex;align-items:center;gap:9px;background:rgba(20,16,32,.7);
    border:1px solid var(--line);border-radius:10px;padding:8px 13px;font-size:.92rem;color:var(--ink-dim)}
  .tchip b{color:var(--ink)}
  .tchip .tic{width:22px;height:22px;object-fit:contain;border-radius:5px}
  .tchip.weak .tic{box-shadow:0 0 0 2px #e0574b, 0 0 7px -1px rgba(224,87,75,.7)}
  .pen{color:var(--physical);font-size:.8rem;margin-left:2px}
  .tags{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:14px}
  .tag{font-family:"Space Mono",monospace;font-size:.68rem;letter-spacing:.06em;color:var(--ink-dim);
    background:var(--veil);border:1px solid var(--line);border-radius:999px;padding:4px 11px}
  .atkspd{font-size:.78rem;color:var(--ink-faint);letter-spacing:.1em}

  .body{padding-top:8px}
  .sec{font-size:1.5rem;margin:44px 0 18px;display:flex;align-items:baseline;gap:12px;flex-wrap:wrap}
  .sec-note{font-size:.72rem;color:var(--ink-faint);font-weight:400;letter-spacing:.04em}
  .skill-list{display:flex;flex-direction:column;gap:14px;margin-top:14px}
  .interference .sec{margin-top:36px}

  @media(max-width:760px){
    .hero-inner{grid-template-columns:1fr;justify-items:center;text-align:center;gap:22px}
    .portrait-col{max-width:260px;width:100%}
    .info-col{width:100%}
    .rarity-row,.class-row,.type-row,.tags{justify-content:center}
  }
  .verdict{margin:0 0 20px;font-size:1.05rem;line-height:1.4;color:var(--ink);
    background:linear-gradient(180deg,color-mix(in srgb,var(--sigil) 12%,var(--veil)),var(--veil));
    border:1px solid color-mix(in srgb,var(--sigil) 34%,var(--line));border-left:3px solid var(--sigil);
    border-radius:var(--r);padding:14px 18px}
  .deploy .sec{margin-top:8px}
  .deploy-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px}
  .deploy-card{background:var(--veil);border:1px solid var(--line);border-radius:var(--r);padding:16px 18px}
  .deploy-card .dl{display:block;font-size:.62rem;letter-spacing:.16em;text-transform:uppercase;color:var(--sigil);margin-bottom:8px}
  .deploy-card p{margin:0 0 8px;font-size:.9rem;color:var(--ink-dim);line-height:1.5}
  .deploy-card p:last-child{margin-bottom:0}
  .deploy-card .fit{color:var(--ink)}
  .deploy-card .hint{font-size:.78rem;color:var(--ink-faint)}
  .deploy-card a{color:var(--sigil)}
  .dchips{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px}
  .dchip{font-family:"Space Mono",monospace;font-size:.66rem;letter-spacing:.04em;color:var(--ink-dim);
    background:var(--nightshade);border:1px solid var(--line);border-radius:999px;padding:3px 10px}
  @media(max-width:860px){
    .witch-layout{grid-template-columns:1fr;gap:18px;padding-top:16px}
    .rail{position:static;top:auto}
    .portrait-frame{height:auto;width:min(280px,72%);order:0}
    .rank{position:sticky;top:64px;z-index:40;order:1;
      background:color-mix(in srgb,var(--bg) 90%,transparent);backdrop-filter:blur(8px);
      padding:9px 6px;border-radius:10px;border:1px solid var(--line)}
    .rank-hint{order:2}
    .hero-bg,.witch::before{height:300px}
  }
</style>

<script>
  const rankEl = document.getElementById('rank');
  if (rankEl) {
    const uibase = rankEl.dataset.uibase;
    const minRank = parseInt(rankEl.dataset.min) || 1;
    const maxRank = parseInt(rankEl.dataset.max) || 6;
    let rank = parseInt(rankEl.dataset.base) || minRank;
    if (rank < minRank) rank = minRank;
    if (rank > maxRank) rank = maxRank;
    const stars = [...rankEl.querySelectorAll('.star')];
    const exs = [...rankEl.querySelectorAll('.exstar')];
    const plusBlocks = [...document.querySelectorAll('.plus-block')];
    const evoBadges = [...document.querySelectorAll('.evo-badge')];
    const scales = [...document.querySelectorAll('.sk-scale')];
    const round2 = v => Math.round(v * 100) / 100;
    const countOf = l => { const m = /[x×](\d+)/i.exec(l); return m ? '×' + m[1] : ''; };
    const humLabel = l => l.replace(/\(.*?\)/g, '').replace(/[x×]\d+/i, '').replace(/_pct$|_s$/, '').replace(/_/g, ' ').trim();
    const unitOf = l => (/pct/i.test(l) ? '%' : (/(_s$|dur|second)/i.test(l) ? 's' : ''));
    const fmt = (c, lv) => { const v = round2(c.val_low + (c.per_level || 0) * (lv - 1)); const cnt = countOf(c.label); return humLabel(c.label) + (cnt ? ' ' + cnt : '') + ' ' + v + unitOf(c.label); };
    function paint() {
      stars.forEach(btn => {
        const pos = +btn.dataset.pos;
        const kind = pos > rank ? 'grey' : (rank >= 4 ? 'yellow' : 'red');
        const img = btn.querySelector('.star-img'); if (img) img.src = uibase + `star_${kind}.png`;
        const g = btn.querySelector('.star-glyph'); if (g) g.dataset.kind = kind;
      });
      exs.forEach(btn => btn.classList.toggle('on', rank >= +btn.dataset.pos));
      plusBlocks.forEach(pb => { const need = parseInt(pb.dataset.unlock) || 6; pb.classList.toggle('locked', rank < need); });
      evoBadges.forEach(b => { const need = parseInt(b.dataset.unlock) || 6; const on = rank >= need; b.classList.toggle('locked', !on); const box = b.closest('.skill-box'); if (box) box.classList.toggle('evolved', on); });
      const dpsEl = document.querySelector('.dps-overall');
      if (dpsEl) { const m = JSON.parse(dpsEl.dataset.overall || '{}'); const v = m[String(rank)]; const t = dpsEl.querySelector('.dps-val'); if (t) t.textContent = (v == null ? '—' : v); }
      let topBox = null, topVal = -1;
      document.querySelectorAll('.sk-score').forEach(sc => {
        const m = JSON.parse(sc.dataset.scores || '{}'); const v = m[String(rank)];
        const t = sc.querySelector('.sc-val'); if (t) t.textContent = (v == null ? '—' : v);
        const box = sc.closest('.skill-box'); if (box) box.classList.remove('top-skill');
        sc.querySelector('.sc-first').hidden = true;
        if (v != null && v > topVal) { topVal = v; topBox = sc; }
      });
      if (topBox && topVal > 0) { const box = topBox.closest('.skill-box'); if (box) box.classList.add('top-skill'); topBox.querySelector('.sc-first').hidden = false; }
      scales.forEach(sc => {
        const base = JSON.parse(sc.dataset.coef || '[]');
        const plus = (sc.dataset.pluscoef && sc.dataset.pluscoef !== 'null') ? JSON.parse(sc.dataset.pluscoef) : null;
        const plusAt = parseInt(sc.dataset.plusat) || 99;
        const maxLv = parseInt(sc.dataset.maxlevel) || 6;
        const lv = Math.min(rank + 1, maxLv);
        const usePlus = plus && rank >= plusAt;
        const active = usePlus ? plus : base;
        const cur = sc.querySelector('.cur-vals'); if (cur) cur.textContent = active.map(c => fmt(c, lv)).join(' · ');
        const lvTag = sc.querySelector('.lv-tag'); if (lvTag) lvTag.textContent = 'Lv ' + lv + (usePlus ? ' +' : '');
        const tbls = [...sc.querySelectorAll('.scale-tbl')];
        tbls.forEach(t => t.querySelectorAll('tr').forEach(tr => tr.classList.remove('active')));
        const tgt = (usePlus && tbls.length > 1) ? tbls[1] : tbls[0];
        if (tgt) { const row = tgt.querySelector(`tr[data-lv="${lv}"]`); if (row) row.classList.add('active'); }
      });
    }
    [...stars, ...exs].forEach(btn => btn.addEventListener('click', () => {
      let p = +btn.dataset.pos; if (p < minRank) p = minRank; if (p > maxRank) p = maxRank; rank = p; paint();
    }));
    paint();
  }
</script>
