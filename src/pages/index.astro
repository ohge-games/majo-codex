---
import Base from '../layouts/Base.astro';
import EyeBadge from '../components/EyeBadge.astro';
import witches from '../data/witches.json';
import fs from 'node:fs';

const base = import.meta.env.BASE_URL;
const hasImg = p => { try { return fs.existsSync(`${process.cwd()}/public${p}`); } catch { return false; } };
const ui = name => `${base}img/ui/${name}.png`;
const hasUi = name => hasImg(`/img/ui/${name}.png`);
const lc = s => (s ?? '').toLowerCase();
const order = { SSR: 0, SR: 1, UR: -1 };
const roster = [...witches].sort((a, b) =>
  (order[a.rarity] ?? 2) - (order[b.rarity] ?? 2) || a.witch_id.localeCompare(b.witch_id));

const classes = [...new Set(roster.map(w => w.class))].sort();
const rarities = ['SSR', 'SR'];
const types = ['mental', 'physical', 'magic'];
const cap = s => s ? s[0].toUpperCase() + s.slice(1) : s;

// Non-interactive "coming soon" tiles — name only, no data. Add entries as they're announced.
const upcoming = [
  { name: 'Isabelle' },
];
---
<Base title="MAJO Codex — Witch Roster">
  <section class="hero">
    <div class="wrap">
      <h1 class="display">Current Witch Roster</h1>
    </div>
  </section>

  <section class="wrap">
    <div class="searchbar" id="searchbar">
      <div class="search-wrap">
        <svg class="search-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M16.5 16.5 21 21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        <input id="search" class="search" type="search" placeholder="Search witches…" autocomplete="off" aria-label="Search witches" />
      </div>
      <div class="count"><span id="count">{roster.length}</span> shown</div>
    </div>

    <div class="filters" id="filters">
      <div class="filter-line">
        <div class="filter-group">
          <span class="filter-label">Class</span>
          {classes.map(c => <button class="chip" data-facet="class" data-val={c}>{c}</button>)}
        </div>
        <div class="filter-group">
          <span class="filter-label">Rarity</span>
          {rarities.map(r => <button class={`chip rarity-btn is-${r}`} data-facet="rarity" data-val={r} title={r} aria-label={r}>{hasUi(`rarity_${lc(r)}`) ? <img class="chip-ic-lg" src={ui(`rarity_${lc(r)}`)} alt={r} height="26" /> : r}</button>)}
        </div>
      </div>
      <div class="filter-line">
        <div class="filter-group">
          <span class="filter-label">Damage</span>
          {types.map(t => <button class={`chip type-${t}`} data-facet="type" data-val={t}>{hasUi(`type_${t}`) && <img class="chip-ic" src={ui(`type_${t}`)} alt="" width="16" height="16" />}{cap(t)}</button>)}
        </div>
        <div class="filter-group">
          <span class="filter-label">Weakness</span>
          {types.map(t => <button class={`chip type-${t}`} data-facet="weakness" data-val={t}>{hasUi(`type_${t}`) && <img class="chip-ic" src={ui(`type_${t}`)} alt="" width="16" height="16" />}{cap(t)}</button>)}
        </div>
      </div>
      <button id="clearall" class="clear-all" hidden>Clear all</button>
      <p class="filter-hint">Click a filter to <b class="hint-inc">show only</b> · again to <b class="hint-exc">exclude</b> · again to clear</p>
    </div>

    <ul class="grid" id="grid">
      {roster.map(w => (
        <li class="card-cell"
            data-class={w.class} data-rarity={w.rarity}
            data-type={w.damage_type} data-weakness={w.weakness_type}
            data-name={w.name.toLowerCase()}
            data-search={`${w.name} ${w.title ?? ''} ${w.class}`.toLowerCase()}
            data-atkspd={w.atk_spd ?? ''} data-order={w.witch_id}>
          <a class={`card rar-${w.rarity}`} href={`${base}witch/${w.witch_id.toLowerCase()}`}>
            <div class="card-bar"></div>
            <div class="portrait">
              {hasUi(`cclass_${lc(w.class)}`)
                ? <img class="cclass" src={ui(`cclass_${lc(w.class)}`)} alt={w.class} title={w.class} width="34" height="34" loading="lazy" />
                : <span class="cls-badge">{w.class}</span>}
              {hasImg(`/img/card/${w.portrait_filename}`) ? (
                <img class="portrait-img" src={`${base}img/card/${w.portrait_filename}`} alt={w.name} loading="lazy" width="256" height="256" />
              ) : (
                <svg viewBox="0 0 24 24" class="sigil" aria-hidden="true">
                  <path d="M2 12 C6 5.5, 18 5.5, 22 12 C18 18.5, 6 18.5, 2 12 Z" fill="none" stroke="currentColor" stroke-width="1"/>
                  <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1"/>
                  <circle cx="12" cy="12" r="1.3" fill="currentColor"/>
                </svg>
              )}
              <div class="badge-strip">
                <span class="bs-type" title={`${cap(w.damage_type)} damage`}>
                  {hasUi(`type_${lc(w.damage_type)}`)
                    ? <img class="type-ic" src={ui(`type_${lc(w.damage_type)}`)} alt={`${cap(w.damage_type)} damage`} width="24" height="24" loading="lazy" />
                    : <EyeBadge type={w.damage_type} size={24} title={`${cap(w.damage_type)} damage`} />}
                </span>
                <span class="bs-rarity">
                  {hasUi(`rarity_${lc(w.rarity)}`)
                    ? <img class="rarity-ic" src={ui(`rarity_${lc(w.rarity)}`)} alt={w.rarity} title={w.rarity} height="30" loading="lazy" />
                    : <span class={`rarity-chip is-${w.rarity}`}>{w.rarity}</span>}
                </span>
                <span class="bs-type weak" title={`Weak to ${cap(w.weakness_type)} (−25%)`}>
                  {hasUi(`type_${lc(w.weakness_type)}`)
                    ? <img class="type-ic" src={ui(`type_${lc(w.weakness_type)}`)} alt={`Weak to ${cap(w.weakness_type)}`} width="24" height="24" loading="lazy" />
                    : <EyeBadge type={w.weakness_type} size={24} title={`Weak to ${cap(w.weakness_type)}`} />}
                </span>
              </div>
            </div>
            <div class="card-foot">
              <span class="wname display">{w.name}</span>
              {w.title && <span class="wtitle">{w.title}</span>}
            </div>
          </a>
        </li>
      ))}
      {upcoming.map(u => (
        <li class="card-cell soon" aria-label={`${u.name} — coming soon`}>
          <div class="card soon-card">
            <div class="card-bar"></div>
            <div class="card-top"><span class="soon-badge mono">Coming soon</span></div>
            <div class="portrait">
              <svg viewBox="0 0 24 24" class="sigil" aria-hidden="true">
                <path d="M2 12 C6 5.5, 18 5.5, 22 12 C18 18.5, 6 18.5, 2 12 Z" fill="none" stroke="currentColor" stroke-width="1"/>
                <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1"/>
                <circle cx="12" cy="12" r="1.3" fill="currentColor"/>
              </svg>
            </div>
            <div class="card-foot">
              <div class="names">
                <span class="wname display">{u.name}</span>
                <span class="wtitle">Not yet released</span>
              </div>
            </div>
          </div>
        </li>
      ))}
    </ul>
    <p class="empty" id="empty" hidden>No witches match those filters. <button id="clear2">Clear</button></p>
  </section>
</Base>

<style>
  .hero{padding:64px 0 34px;border-bottom:1px solid var(--line);
    background:radial-gradient(700px 340px at 50% -40%, rgba(139,108,255,.16), transparent 70%)}
  .hero h1{font-size:clamp(2.4rem,6vw,4.1rem);margin:.15em 0 .25em;
    background:linear-gradient(180deg,var(--ink),#c3b8ea);-webkit-background-clip:text;background-clip:text;color:transparent}
  .lede{color:var(--ink-dim);max-width:52ch;font-size:1.05rem}
  .lede .mono{color:var(--sigil)}

  .searchbar{display:flex;flex-wrap:wrap;align-items:center;gap:12px;
    padding:24px 0 14px;position:sticky;top:64px;background:rgba(12,10,21,.9);
    backdrop-filter:blur(8px);z-index:20}
  .search-wrap{position:relative;flex:1 1 240px;min-width:0}
  .search-ico{position:absolute;left:12px;top:50%;transform:translateY(-50%);
    width:16px;height:16px;color:var(--ink-faint);pointer-events:none}
  .search{width:100%;font:inherit;font-size:.9rem;color:var(--ink);
    background:var(--veil);border:1px solid var(--line);border-radius:999px;
    padding:9px 14px 9px 36px;outline:none;transition:.15s}
  .search::placeholder{color:var(--ink-faint)}
  .search:focus{border-color:var(--sigil);box-shadow:0 0 0 3px color-mix(in srgb,var(--sigil) 22%,transparent)}
  .search::-webkit-search-cancel-button{filter:invert(.6)}
  .sortwrap{display:flex;align-items:center;gap:8px;font-family:"Space Mono",monospace;
    font-size:.66rem;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-faint);white-space:nowrap}
  .sort{font-family:"Inter",sans-serif;font-size:.82rem;letter-spacing:0;text-transform:none;
    color:var(--ink);background:var(--veil);border:1px solid var(--line);border-radius:8px;
    padding:7px 10px;cursor:pointer}
  .sort:focus{outline:none;border-color:var(--sigil)}

  .filters{display:flex;flex-direction:column;gap:12px;padding:2px 0 20px;position:relative}
  .filter-line{display:flex;flex-wrap:wrap;gap:10px 40px}
  .filter-group{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
  .filter-label{font-family:"Space Mono",monospace;font-size:.66rem;letter-spacing:.2em;
    text-transform:uppercase;color:var(--ink-faint);width:74px;flex-shrink:0}
  .chip{font:inherit;font-size:.8rem;cursor:pointer;padding:5px 13px;border-radius:999px;
    border:1px solid var(--line);background:var(--veil);color:var(--ink-dim);transition:.15s}
  .chip:hover{border-color:var(--ink-faint);color:var(--ink)}
  .chip[aria-pressed="true"]{background:var(--veil-2);color:var(--ink);border-color:currentColor;
    box-shadow:0 0 0 1px currentColor inset}
  .chip[data-state="include"]{color:var(--ink);border-color:#54d68a;
    box-shadow:0 0 0 1px #54d68a inset, 0 0 12px -3px rgba(84,214,138,.6)}
  .chip[data-state="exclude"]{color:var(--ink-dim);border-color:#e0574b;
    box-shadow:0 0 0 1px #e0574b inset, 0 0 12px -3px rgba(224,87,75,.55)}
  .rarity-btn{padding:4px 12px}
  .chip-ic-lg{height:26px;width:auto;object-fit:contain;display:block}
  .filter-hint{margin:4px 0 0;font-size:.72rem;color:var(--ink-faint)}
  .filter-hint b{font-weight:600}
  .hint-inc{color:#54d68a} .hint-exc{color:#e0574b}
  .clear-all{align-self:flex-start;margin-top:2px;font:inherit;font-size:.74rem;cursor:pointer;
    color:var(--ink-dim);background:none;border:none;padding:2px 0;text-decoration:underline;
    text-underline-offset:3px}
  .clear-all:hover{color:var(--ink)}
  .count{margin-left:auto;font-family:"Space Mono",monospace;font-size:.78rem;color:var(--ink-faint);white-space:nowrap}
  .count span{color:var(--ink)}

  .grid{list-style:none;margin:0;padding:8px 0 0;display:grid;gap:18px;
    grid-template-columns:repeat(auto-fill,minmax(210px,1fr))}
  .card-cell[hidden]{display:none}
  .card{position:relative;display:flex;flex-direction:column;background:var(--veil);
    border:1px solid var(--line);border-radius:var(--r);overflow:hidden;transition:.18s;height:100%}
  .card:hover{transform:translateY(-4px);border-color:var(--ink-faint);box-shadow:var(--shadow)}
  .rar-SR{--rc:var(--sr)} .rar-SSR{--rc:var(--ssr)} .rar-UR{--rc:var(--ur)}
  .card-bar{height:4px;background:var(--rc)}
  .card-top{display:flex;justify-content:space-between;align-items:center;padding:10px 12px 6px;min-height:34px}
  .cclass{position:absolute;top:0;left:0;z-index:2;width:54px;height:54px;object-fit:contain;object-position:left top;display:block}
  .cls-badge{position:absolute;top:6px;left:6px;z-index:2;font-family:"Space Mono",monospace;
    font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;color:var(--ink);
    background:rgba(12,10,21,.7);border:1px solid var(--line);border-radius:6px;padding:2px 6px}
  .rarity-ic{height:23px;width:auto;object-fit:contain;flex-shrink:0}
  .type-ic{width:20px;height:20px;object-fit:contain;display:block}
  .chip-ic{width:16px;height:16px;object-fit:contain;margin-right:6px;vertical-align:-3px}
  .chip{display:inline-flex;align-items:center}
  .cls{font-family:"Space Mono",monospace;font-size:.66rem;letter-spacing:.14em;
    text-transform:uppercase;color:var(--ink-faint)}
  .portrait{position:relative;aspect-ratio:1/1;margin:8px 12px 0;border-radius:8px;
    background:linear-gradient(160deg,var(--veil-2),#0f0c1c);
    display:grid;place-items:center;color:var(--rc);overflow:hidden}
  .portrait::after{content:"";position:absolute;inset:0;
    background:radial-gradient(120px 120px at 50% 30%, color-mix(in srgb,var(--rc) 22%,transparent), transparent 70%)}
  .portrait .sigil{width:46%;opacity:.5}
  .portrait-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:top center}
  .portrait .id{position:absolute;bottom:7px;right:9px;font-size:.6rem;color:var(--ink-faint)}
  .badge-strip{position:absolute;left:0;right:0;bottom:0;z-index:2;display:flex;align-items:flex-end;
    justify-content:space-between;padding:6px 9px 7px;gap:6px;
    background:linear-gradient(180deg,transparent,rgba(10,8,18,.82))}
  .bs-type{display:flex}
  .bs-type .type-ic{width:24px;height:24px;object-fit:contain;display:block;
    filter:drop-shadow(0 1px 2px rgba(0,0,0,.7))}
  .bs-type.weak .type-ic,.bs-type.weak :global(.eye-badge){border-radius:6px;
    box-shadow:0 0 0 2px #e0574b, 0 0 7px -1px rgba(224,87,75,.75)}
  .bs-rarity{display:flex;align-items:flex-end}
  .bs-rarity .rarity-ic{height:30px;width:auto;object-fit:contain;filter:drop-shadow(0 1px 3px rgba(0,0,0,.8))}
  .card-foot{display:flex;flex-direction:column;align-items:center;gap:2px;padding:10px 12px 13px;text-align:center}
  .wname{font-size:1.14rem;color:var(--ink);line-height:1.15;letter-spacing:.01em;
    overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:100%}
  .wtitle{font-size:.7rem;color:var(--ink-faint);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}

  .soon{pointer-events:none}
  .soon-card{opacity:.42;filter:grayscale(.5);border-style:dashed}
  .soon-card .card-bar{background:var(--ink-faint)}
  .soon-card .portrait{color:var(--ink-faint)}
  .soon-badge{font-size:.6rem;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-faint);
    border:1px solid var(--line);border-radius:999px;padding:2px 9px}
  .soon-card .wtitle{color:var(--ink-faint)}

  .empty{color:var(--ink-dim);padding:40px 0}
  .empty button{background:none;border:1px solid var(--line);color:var(--ink);
    border-radius:6px;padding:4px 12px;cursor:pointer}
  @media (prefers-reduced-motion:reduce){.card:hover{transform:none}}
</style>

<script>
  const FACETS = ['class', 'rarity', 'type', 'weakness'];
  const state = {
    class:    { inc: new Set(), exc: new Set() },
    rarity:   { inc: new Set(), exc: new Set() },
    type:     { inc: new Set(), exc: new Set() },
    weakness: { inc: new Set(), exc: new Set() },
    q: '',
  };

  const chips = [...document.querySelectorAll('.chip')];
  const cells = [...document.querySelectorAll('.card-cell:not(.soon)')];
  const soonCells = [...document.querySelectorAll('.card-cell.soon')];
  const countEl = document.getElementById('count');
  const emptyEl = document.getElementById('empty');
  const searchEl = document.getElementById('search');
  const clearAll = document.getElementById('clearall');

  const anyActive = () => state.q ||
    FACETS.some(f => state[f].inc.size || state[f].exc.size);

  function passesFacet(cell, facet) {
    const v = cell.dataset[facet];
    const { inc, exc } = state[facet];
    if (exc.has(v)) return false;
    if (inc.size && !inc.has(v)) return false;
    return true;
  }

  function apply() {
    let n = 0;
    for (const cell of cells) {
      const ok = FACETS.every(f => passesFacet(cell, f)) &&
                 (!state.q || cell.dataset.search.includes(state.q));
      cell.hidden = !ok;
      if (ok) n++;
    }
    // coming-soon tiles only show in the unfiltered default view
    soonCells.forEach(c => { c.hidden = anyActive(); });

    countEl.textContent = n;
    emptyEl.hidden = n !== 0;
    clearAll.hidden = !anyActive();
  }

  // tri-state chips: neutral -> include -> exclude -> neutral
  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      const { facet, val } = chip.dataset;
      const { inc, exc } = state[facet];
      const cur = chip.dataset.state || '';
      if (cur === '') { inc.add(val); chip.dataset.state = 'include'; chip.setAttribute('aria-pressed', 'true'); }
      else if (cur === 'include') { inc.delete(val); exc.add(val); chip.dataset.state = 'exclude'; chip.setAttribute('aria-pressed', 'false'); }
      else { exc.delete(val); chip.dataset.state = ''; chip.removeAttribute('aria-pressed'); }
      apply();
    });
  });

  searchEl.addEventListener('input', () => { state.q = searchEl.value.trim().toLowerCase(); apply(); });

  function reset() {
    state.q = ''; searchEl.value = '';
    FACETS.forEach(f => { state[f].inc.clear(); state[f].exc.clear(); });
    chips.forEach(c => { c.dataset.state = ''; c.removeAttribute('aria-pressed'); });
    apply();
  }
  clearAll.addEventListener('click', reset);
  document.getElementById('clear2')?.addEventListener('click', reset);

  apply();
</script>
