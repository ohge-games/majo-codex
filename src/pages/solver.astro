---
import Base from '../layouts/Base.astro';
import witches from '../data/witches.json';
import skills from '../data/skills.json';
import engine from '../data/solver_engine.json';
import fs from 'node:fs';
const base = import.meta.env.BASE_URL;
const lc = s => (s ?? '').toLowerCase();
const hasImg = p => { try { return fs.existsSync(`${process.cwd()}/public${p}`); } catch { return false; } };
const uiUrl = n => hasImg(`/img/ui/${n}.png`) ? `${base}img/ui/${n}.png` : null;
const portraitOf = f => hasImg(`/img/card/${f}`) ? `${base}img/card/${f}` : hasImg(`/img/hero/${f}`) ? `${base}img/hero/${f}` : null;
const skillIco = (id, slot) => hasImg(`/img/skill/${lc(id)}_${slot}.png`) ? `${base}img/skill/${lc(id)}_${slot}.png` : null;

const WMETA = Object.fromEntries(witches.map(w => [w.witch_id, w]));
const SKILLNAME = {};
for (const s of skills) SKILLNAME[`${s.witch_id}_${lc(s.slot)}`] = s.name;

const MAX_STATS = {
  'Arcanist_SR': { atk: 2499, cr: 0.3698, cd: 1.8488, ed: 0.0174 },
  'Arcanist_SSR': { atk: 3483, cr: 0.3978, cd: 1.9888, ed: 0.0759 },
  'Vanguard_SR': { atk: 2264, cr: 0.20, cd: 2.5968, ed: 0.0143 },
  'Vanguard_SSR': { atk: 3118, cr: 0.20, cd: 1.8768, ed: 0.0728 },
  'Defender_SR': { atk: 1170, cr: 0.20, cd: 1.00, ed: 0.0141 },
  'Defender_SSR': { atk: 1618, cr: 0.20, cd: 1.00, ed: 0.0141 },
  'Defender_UR': { atk: 1672, cr: 0.20, cd: 1.00, ed: 0.0141 },
  'Supporter_SR': { atk: 1637, cr: 0.20, cd: 1.00, ed: 0.0145 },
  'Supporter_SSR': { atk: 2300, cr: 0.20, cd: 1.00, ed: 0.0145 },
};
const W = Object.entries(engine.witches).map(([id, e]) => {
  const m = WMETA[id] || {};
  return { id, name: m.name, title: m.title || '', cls: e.cls, rar: e.rar, el: e.el, weak: e.weak,
    amp: e.amp, minrank: e.minrank, maxrank: e.maxrank, img: portraitOf(m.portrait_filename),
    intf: e.intf || {}, echarge: e.echarge || 0, ehits: e.ehits || 0, estacks: e.estacks || 0,
    skills: e.skills.map(s => ({ ...s, name: SKILLNAME[`${id}_${s.slot}`] || s.slot, ico: skillIco(id, s.slot) })) };
});
const carries = W.filter(w => w.cls === 'Arcanist' || w.cls === 'Vanguard').map(w => w.id);
const fillers = W.filter(w => w.cls === 'Supporter' || w.cls === 'Defender').map(w => w.id);
const UI = {};
for (const t of ['physical','mental','magic']) UI['type_' + t] = uiUrl('type_' + t);
for (const c of ['arcanist','vanguard','defender','supporter']) UI['cclass_' + c] = uiUrl('cclass_' + c);
for (const r of ['sr','ssr','ur']) UI['rarity_' + r] = uiUrl('rarity_' + r);
for (const s of ['red','yellow','grey','ex1','ex2','ex3']) UI['star_' + s] = uiUrl('star_' + s);
const BOSSES = [
  { id: 'venomfrill', name: 'Venomfrill', weak: 'physical', staggerThreshold: 255, kdDur: 8, stackCap: 6, aoe: 0.23 },
  { id: 'dummy', name: 'Test Dummy (no weakness / no knockdown)', weak: 'none', kd: 0.1, aoe: 0.1 },
];
const RES = {
  arc: [14, 17, 20], van: [13, 19, 25],           // 2x class
  mag2: [6, 8, 10], phy2: [9, 12, 15], men2: [13, 19, 25], sup2: [16, 23, 30], // 2x element/class
  mag4: [4, 5, 6], men4: [20, 25, 30], phy4: [4, 5, 6], // 4x element (per-stack)
};
const payload = { W, carries, fillers, MAX_STATS, UI, BOSSES, RES };
---
<Base title="DPS Solver — MAJO Codex" desc="Add the carries you've invested in and rank teams for your account.">
<div id="svapp">
  <a class="back mono" href={base}>&larr; All witches</a>

  <section class="solver wrap">
    <header class="sv-head">
      <span class="eyebrow">Astrolabe Solver</span>
      <h1 class="display">Rank teams for <em>your</em> account</h1>
      <p class="sub">Add the Arcanists and Vanguards you've invested in — their stats, star rank, and skill levels.
        Supporters and Defenders fill the healer and utility slots at max, so you only track your carries. The board
        re-ranks live and everything is saved to this browser.</p>
    </header>

    <div class="lawbar panel">
      <div class="lb-boss">
        <span class="p-title mono">Boss</span>
        <select id="boss" class="field"></select>
      </div>
      <div class="lb-laws">
        <span class="p-title mono">Astrolabe resonances</span>
        <div class="resbar" id="resbar"></div>
      </div>
    </div>

    <div class="sv-grid">
      <aside class="roster">
        <div class="roster-head">
          <span class="p-title mono">Your carries · <span id="poolCount">0</span></span>
          <button id="reset" class="btn ghost sm" type="button">Clear all</button>
        </div>
        <div id="pool" class="pool"></div>
        <button id="share" class="btn ghost" type="button">Copy shareable link</button>
      </aside>

      <div class="results">
        <div class="res-head">
          <span class="eyebrow">Recommended teams</span>
          <span id="resNote" class="mono note"></span>
        </div>
        <div id="board" class="board"></div>
      </div>
    </div>
  </section>

  <div id="modal" class="modal" hidden>
    <div class="modal-back" id="modalBack"></div>
    <div class="modal-card">
      <div class="modal-head">
        <span id="modalTitle" class="display">Add a carry</span>
        <button id="modalX" class="modal-x" type="button" aria-label="Close">&times;</button>
      </div>
      <div class="modal-body">
        <div class="m-top">
          <div class="m-col">
            <div class="m-row" id="mSelectRow"><label class="m-lbl mono">Witch</label><select id="mWitch" class="field"></select></div>
            <div class="m-info" id="mInfo"></div>
          </div>
          <div class="m-col">
            <label class="m-lbl mono">Star rank</label>
            <div class="stars" id="mStars"></div>
          </div>
        </div>
        <div class="m-stats">
          <label class="mf"><span class="mono">ATK</span><input id="mAtk" inputmode="decimal"></label>
          <label class="mf" id="mCrWrap"><span class="mono">Crit %</span><input id="mCr" inputmode="decimal"></label>
          <label class="mf"><span class="mono">Crit Dmg %</span><input id="mCd" inputmode="decimal"></label>
          <label class="mf"><span class="mono">Extra %</span><input id="mEd" inputmode="decimal"></label>
        </div>
        <div class="m-skills" id="mSkills"></div>
      </div>
      <div class="modal-foot">
        <button id="mRemove" class="btn ghost danger" type="button" hidden>Remove</button>
        <span class="spacer"></span>
        <button id="mCancel" class="btn ghost" type="button">Cancel</button>
        <button id="mSave" class="btn" type="button">Save</button>
      </div>
    </div>
  </div>

  <script type="application/json" id="sv-data" set:html={JSON.stringify(payload)}></script>

  <script>
    import { createModel } from '../lib/boss_model.mjs';
    const DATA = JSON.parse(document.getElementById('sv-data').textContent);
    const { W, carries, fillers, MAX_STATS, UI, BOSSES, RES } = DATA;
    const CARRY = new Set(carries), FILLERS = fillers;
    const WMAP = new Map(W.map(w => [w.id, w]));
    const byId = id => WMAP.get(id);
    const CAP = s => s ? s[0].toUpperCase() + s.slice(1) : s;
    const lc = s => (s || '').toLowerCase();
    const $ = id => document.getElementById(id);
    const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));
    const MAXLV = w => w.rar === 'SR' ? 7 : 10;
    const lvCap = (w, R) => Math.min(MAXLV(w), R + 1);
    const lvLabel = v => v <= 7 ? `Lv ${v}` : `EX-${v - 7}`;
    const rankLabel = r => r <= 6 ? `${r}\u2605` : `EX-${r - 6}`;

    const defUnit = w => {
      const R = w.maxrank, lv = {};
      for (const s of w.skills) lv[s.slot] = Math.min(s.maxlv, R + 1);
      return { rank: R, ...MAX_STATS[`${w.cls}_${w.rar}`], lv };
    };
    const DEFAULT = () => ({ boss: 'venomfrill', units: {},
      laws: { charge: true, stagger: false, start120: true,
        arc: 0, van: 0, mag2: 0, phy2: 0, men2: 0, sup2: 0, mag4: 0, men4: 0, phy4: 0 } });
    let S = load() || DEFAULT();
    S.laws = { ...DEFAULT().laws, ...(S.laws || {}) };   // migrate older saved states to new law keys
    function statsFor(id) { const w = byId(id); return S.units[id] || defUnit(w); }
    const owned = () => Object.keys(S.units).filter(id => CARRY.has(id));
    const teamPool = () => [...owned(), ...FILLERS];

    let _t; const scheduleSolve = () => { clearTimeout(_t); _t = setTimeout(solve, 90); };
    const modelWitches = () => Object.fromEntries(W.map(w => [w.id, w]));
    function solve() {
      const own = owned(), boss = BOSSES.find(b => b.id === S.boss);
      if (!own.length) { renderEmpty(); return; }
      const model = createModel(modelWitches(), { units: S.units });
      const rows = model.board({ boss, laws: S.laws, carriesToRank: own, pool: teamPool() });
      render(rows, boss);
    }

    const elC = e => `type-${e}`;
    function renderEmpty() {
      $('resNote').textContent = '';
      $('board').innerHTML = `<div class="empty"><p>No carries yet.</p><p class="mono">Add an Arcanist or Vanguard to see the teams that rank best for your account.</p></div>`;
    }
    function render(rows, boss) {
      const top = rows[0]?.eff || 1;
      $('resNote').textContent = `vs ${boss.name} \u00b7 relative to top`;
      $('board').innerHTML = rows.map((r, i) => {
        const cw = byId(r.carry);
        const mates = r.team.filter(t => t !== r.carry).map(t => { const m = byId(t);
          return `<span class="mate"><b>${m.name}</b><i class="${elC(m.el)}">${m.cls}</i></span>`; }).join('');
        const why = r.why.map(x => `<li>${x}</li>`).join('');
        const pct = Math.round(r.eff / top * 100);
        return `<article class="comp${i===0?' top':''}"><div class="comp-rank mono">#${i+1}</div>
          <div class="comp-body"><div class="comp-carry"><span class="c-name display">${cw.name}</span>
            <span class="rarity-chip is-${cw.rar}">${cw.rar}</span><span class="c-tag ${elC(cw.el)} mono">${CAP(cw.el)} ${cw.cls}</span>
            ${r.weak < 1 ? '<span class="offweak mono">off-weakness \u00d7.75</span>' : ''}</div>
            <div class="comp-team">${mates}</div><ul class="comp-why mono">${why}</ul></div>
          <div class="comp-score"><span class="s-val">${pct}</span><span class="s-bar"><i style="width:${pct}%"></i></span></div></article>`;
      }).join('');
    }

    // ---------- resonance bar (icon selectors) ----------
    function iconFor(kind, key) {
      const u = UI[`${kind}_${key}`];
      return u ? `<img src="${u}" alt="${key}" width="22" height="22">` : `<span class="ic-fallback ${kind==='type'?elC(key):''}">${CAP(key)[0]}</span>`;
    }
    const RESLIST = [
      { k: 'arc',  label: 'Arcanist', tag: '2\u00d7', icon: ['cclass','arcanist'], ladder: RES.arc,  unit: '%', desc: '2 Arcanists \u2014 crit rate' },
      { k: 'van',  label: 'Vanguard', tag: '2\u00d7', icon: ['cclass','vanguard'], ladder: RES.van,  unit: '%', desc: '2 Vanguards \u2014 attack speed' },
      { k: 'mag2', label: 'Magic',    tag: '2\u00d7', icon: ['type','magic'],      ladder: RES.mag2, unit: '%', desc: '2 Magic \u2014 Extreme charge speed' },
      { k: 'phy2', label: 'Physical', tag: '2\u00d7', icon: ['type','physical'],   ladder: RES.phy2, unit: '%', desc: '2 Physical \u2014 block & dodge rate (survivability, not scored)' },
      { k: 'men2', label: 'Mental',   tag: '2\u00d7', icon: ['type','mental'],     ladder: RES.men2, unit: '%', desc: '2 Mental \u2014 damage to knocked-down targets' },
      { k: 'sup2', label: 'Supporter',tag: '2\u00d7', icon: ['cclass','supporter'],ladder: RES.sup2, unit: '%', desc: '2 Supporters \u2014 healing effect (not scored)' },
      { k: 'mag4', label: 'Magic',    tag: '4\u00d7', icon: ['type','magic'],      ladder: RES.mag4, unit: '%/stk', desc: '4 Magic \u2014 magic damage on Extreme, 25s, max 10 stacks' },
      { k: 'men4', label: 'Mental',   tag: '4\u00d7', icon: ['type','mental'],     ladder: RES.men4, unit: '%/stk', desc: '4 Mental \u2014 mental damage on execution, 40s, max 3 stacks' },
      { k: 'phy4', label: 'Physical', tag: '4\u00d7', icon: ['type','physical'],   ladder: RES.phy4, unit: '%/stk', desc: '4 Physical \u2014 physical damage on counter, 20s, max 10 stacks' },
    ];
    const TOGGLES = [
      { k: 'charge',  label: '+20% charge', tag: 'S/A/V',   title: '+20% Extreme charge with 1 Supporter, Arcanist & Vanguard on the team' },
      { k: 'stagger', label: '+.5 stagger', tag: '2S/A/V',  title: '+0.5 stagger value with 2 Supporters, Arcanist & Vanguard (enables knockdown \u2014 not directly scored)' },
      { k: 'start120',label: '+120 start',  tag: '',        title: '+120 Extreme charge at battle start' },
    ];
    function renderResbar() {
      const togs = TOGGLES.map(t => `<button class="restog${S.laws[t.k]?' on':''}" data-tog="${t.k}" type="button" title="${t.title}">${t.label}${t.tag?` <i>${t.tag}</i>`:''}</button>`).join('');
      const pills = RESLIST.map(r => {
        const lvl = S.laws[r.k];
        const off = `<button class="lvb off${lvl===0?' on':''}" data-res="${r.k}" data-lv="0" type="button" title="Not unlocked / off">\u2013</button>`;
        const pips = [1,2,3].map(n => `<button class="lvb${lvl>=n?' on':''}" data-res="${r.k}" data-lv="${n}" type="button" title="${r.label} ${r.tag} Lv${n} \u00b7 ${r.ladder[n-1]}${r.unit}">${n}</button>`).join('');
        return `<div class="respill${lvl>0?' on':''}" title="${r.desc} (\u2013 = off)"><span class="ric">${iconFor(r.icon[0], r.icon[1])}</span><span class="rtag mono">${r.tag}</span><span class="rlv">${off}${pips}</span></div>`;
      }).join('');
      $('resbar').innerHTML = togs + pills;
      $('resbar').querySelectorAll('[data-tog]').forEach(b => b.addEventListener('click', () => { S.laws[b.dataset.tog] = !S.laws[b.dataset.tog]; save(); renderResbar(); solve(); }));
      $('resbar').querySelectorAll('.lvb').forEach(p => p.addEventListener('click', () => {
        const k = p.dataset.res, n = +p.dataset.lv; S.laws[k] = (S.laws[k] === n) ? 0 : n; save(); renderResbar(); solve();
      }));
    }

    // ---------- pool tiles (photo + star rating + stats + skill levels) ----------
    function miniStars(w, R) {
      let h = '';
      for (let r = 1; r <= 6; r++) { const k = r > R ? 'grey' : (R >= 4 ? 'yellow' : 'red');
        h += UI['star_'+k] ? `<img class="ms" src="${UI['star_'+k]}" alt="">` : `<span class="msg ${k}">\u2605</span>`; }
      if (w.maxrank > 6) for (let n = 1; n <= 3 && 6 + n <= R; n++)
        h += UI['star_ex'+n] ? `<img class="ms ex" src="${UI['star_ex'+n]}" alt="EX${n}">` : `<span class="msg ex">EX${n}</span>`;
      return h;
    }
    function renderPool() {
      const ids = owned();
      $('poolCount').textContent = ids.length;
      const add = `<button class="tile add" id="addTile" type="button"><span class="plus">+</span><span class="mono">Add my Witch</span></button>`;
      const tiles = ids.map(id => {
        const w = byId(id), st = statsFor(id), R = st.rank ?? w.maxrank, cap = lvCap(w, R);
        const port = w.img ? `<img class="portrait-img" src="${w.img}" alt="${w.name}" loading="lazy">`
          : `<svg viewBox="0 0 24 24" class="sigil"><path d="M2 12 C6 5.5, 18 5.5, 22 12 C18 18.5, 6 18.5, 2 12 Z" fill="none" stroke="currentColor" stroke-width="1"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1"/></svg>`;
        const lvStr = w.skills.map(s => {
          if (R < s.req) return 'X';
          const v = clamp((st.lv && st.lv[s.slot]) || cap, 1, cap);
          return v > 7 ? `EX-${v-7}` : `${v}`;
        }).join(' / ');
        const cr = w.cls === 'Arcanist' ? `${(st.cr*100).toFixed(0)}%` : '20%';
        return `<div class="tile rar-${w.rar}" data-id="${id}">
          <div class="tportrait">${port}<button class="edit mono" data-edit="${id}" type="button">Edit</button><span class="tname display">${w.name}</span></div>
          <div class="trow"><span class="trank mono">${rankLabel(R)}</span>
            <span class="tstat mono">${st.atk} / ${cr} / ${(st.cd*100).toFixed(0)}%</span></div>
          <div class="tlv mono">${lvStr}</div>
        </div>`;
      }).join('');
      $('pool').innerHTML = add + tiles;
      $('addTile').addEventListener('click', () => openModal(null));
      $('pool').querySelectorAll('[data-edit]').forEach(b => b.addEventListener('click', () => openModal(b.dataset.edit)));
    }

    // ---------- modal ----------
    let editing = null, mRank = null, mId = null;
    function openModal(id) {
      editing = id;
      $('modalTitle').textContent = id ? `Edit ${byId(id).name}` : 'Add a carry';
      $('mRemove').hidden = !id;
      const sel = $('mWitch');
      if (id) { $('mSelectRow').hidden = true; loadModal(id, statsFor(id)); }
      else {
        $('mSelectRow').hidden = false;
        const avail = carries.filter(c => !S.units[c]);
        sel.innerHTML = avail.length ? avail.map(c => `<option value="${c}">${byId(c).name} \u00b7 ${byId(c).cls} ${byId(c).rar}</option>`).join('') : '<option>All carries added</option>';
        if (avail[0]) loadModal(avail[0], defUnit(byId(avail[0])));
      }
      $('modal').hidden = false;
    }
    function loadModal(id, st) {
      mId = id; mRank = st.rank ?? byId(id).maxrank;
      const w = byId(id);
      $('mInfo').innerHTML = `<span class="chip mono">${w.cls}</span><span class="chip mono ${elC(w.el)}">${CAP(w.el)} dmg</span><span class="chip mono ${elC(w.weak)}">Weak: ${CAP(w.weak)}</span><span class="rarity-chip is-${w.rar}">${w.rar}</span>`;
      $('mAtk').value = st.atk; $('mCr').value = (st.cr*100).toFixed(2); $('mCd').value = (st.cd*100).toFixed(2); $('mEd').value = (st.ed*100).toFixed(2);
      $('mCrWrap').style.display = w.cls === 'Arcanist' ? '' : 'none';
      renderStars(); renderModalSkills(st.lv || {});
    }
    function renderStars() {
      const w = byId(mId);
      let html = '';
      for (let r = 1; r <= 6; r++) {
        const kind = r > mRank ? 'grey' : (mRank >= 4 ? 'yellow' : 'red'), disabled = r < w.minrank;
        const face = UI['star_'+kind] ? `<img src="${UI['star_'+kind]}" alt="">` : `<span class="star-glyph ${kind}">\u2605</span>`;
        html += `<button class="star" data-rank="${r}" type="button" ${disabled?'disabled':''} title="${r}\u2605">${face}</button>`;
      }
      if (w.maxrank > 6) for (let n = 1; n <= 3; n++) {
        const r = 6 + n, on = mRank >= r;
        const face = UI['star_ex'+n] ? `<img src="${UI['star_ex'+n]}" alt="EX${n}">` : `<span class="ex-txt">EX${n}</span>`;
        html += `<button class="exstar${on?' on':''}" data-rank="${r}" type="button" title="EX-${n}">${face}</button>`;
      }
      $('mStars').innerHTML = html;
      $('mStars').querySelectorAll('.star,.exstar').forEach(b => b.addEventListener('click', () => {
        if (b.disabled) return;
        mRank = +b.dataset.rank; renderStars();
        const lv = {}; $('mSkills').querySelectorAll('.slider').forEach(sl => lv[sl.dataset.slot] = +sl.value);
        renderModalSkills(lv);
      }));
    }
    function renderModalSkills(curLv) {
      const w = byId(mId), cap = lvCap(w, mRank);
      $('mSkills').innerHTML = w.skills.map(s => {
        const locked = mRank < s.req;
        const face = s.ico ? `<img class="ms-ico" src="${s.ico}" alt="">` : `<span class="ms-ico txt">${s.slot[0].toUpperCase()}</span>`;
        const note = !s.score && !s.amp ? '<span class="ms-note">buff \u00b7 no dmg</span>' : s.amp ? '<span class="ms-note">amp</span>' : '';
        if (locked) return `<div class="mskill locked"><div class="ms-ico-wrap">${face}</div><span class="ms-name">${s.name}</span><span class="ms-lv mono">locked \u00b7 ${rankLabel(s.req)}</span></div>`;
        const v = clamp(curLv[s.slot] || cap, 1, cap);
        const plus = s.plus_star && mRank >= s.plus_star ? '<span class="ms-plus">+</span>' : '';
        return `<div class="mskill"><div class="ms-ico-wrap">${face}${plus}</div><span class="ms-name">${s.name}${note}</span>
          <span class="ms-lv mono" id="lbl_${s.slot}">${lvLabel(v)}</span>
          <input type="range" min="1" max="${cap}" value="${v}" data-slot="${s.slot}" class="slider"></div>`;
      }).join('');
      $('mSkills').querySelectorAll('.slider').forEach(sl => sl.addEventListener('input', () => { $('lbl_'+sl.dataset.slot).textContent = lvLabel(+sl.value); }));
    }
    function readModal() {
      const id = editing || mId, w = byId(id);
      const num = (el, d) => { const v = parseFloat($(el).value); return isNaN(v) ? d : v; };
      const cap = lvCap(w, mRank), lv = {};
      w.skills.forEach(s => { lv[s.slot] = Math.min(s.maxlv, cap); });
      $('mSkills').querySelectorAll('.slider').forEach(sl => lv[sl.dataset.slot] = +sl.value);
      const cr = w.cls === 'Arcanist' ? num('mCr', 20)/100 : MAX_STATS[`${w.cls}_${w.rar}`].cr;
      return { id, unit: { rank: mRank, atk: num('mAtk', 0), cr, cd: num('mCd', 0)/100, ed: num('mEd', 0)/100, lv } };
    }
    const closeModal = () => { $('modal').hidden = true; editing = null; };

    function fillSelects() {
      $('boss').innerHTML = BOSSES.map(b => `<option value="${b.id}">${b.name}</option>`).join('');
      $('boss').value = S.boss;
    }
    function wire() {
      $('boss').addEventListener('change', e => { S.boss = e.target.value; save(); solve(); });
      $('reset').addEventListener('click', () => { if (confirm('Remove all carries?')) { S.units = {}; save(); renderPool(); solve(); } });
      $('share').addEventListener('click', () => {
        const url = location.origin + location.pathname + '#' + btoa(encodeURIComponent(JSON.stringify(S)));
        navigator.clipboard.writeText(url).then(() => { const b=$('share'),t=b.textContent; b.textContent='Copied \u2713'; setTimeout(()=>b.textContent=t,1400); });
      });
      $('mSave').addEventListener('click', () => { const { id, unit } = readModal(); S.units[id] = unit; save(); closeModal(); renderPool(); solve(); });
      $('mCancel').addEventListener('click', closeModal);
      $('modalX').addEventListener('click', closeModal);
      $('modalBack').addEventListener('click', closeModal);
      $('mRemove').addEventListener('click', () => { if (editing) { delete S.units[editing]; save(); closeModal(); renderPool(); solve(); } });
      $('mWitch').addEventListener('change', () => { const nid = $('mWitch').value; loadModal(nid, defUnit(byId(nid))); });
    }
    function save() { try { localStorage.setItem('majo-solver-v4', JSON.stringify(S)); } catch {} }
    function load() {
      try {
        if (location.hash.length > 1) { const h = JSON.parse(decodeURIComponent(atob(location.hash.slice(1)))); if (h.units) return h; }
        const raw = localStorage.getItem('majo-solver-v4'); return raw ? JSON.parse(raw) : null;
      } catch { return null; }
    }

    fillSelects(); renderResbar(); wire(); renderPool(); solve();
  </script>

