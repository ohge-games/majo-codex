---
import Base from '../layouts/Base.astro';
import witches from '../data/witches.json';
import skills from '../data/skills.json';
import engine from '../data/solver_engine.json';
import fs from 'node:fs';
const base = import.meta.env.BASE_URL;
const lc = s => (s ?? '').toLowerCase();
const hasImg = p => { try { return fs.existsSync(`${process.cwd()}/public${p}`); } catch { return false; } };
const uiUrl = name => hasImg(`/img/ui/${name}.png`) ? `${base}img/ui/${name}.png` : null;
const portraitOf = f => hasImg(`/img/card/${f}`) ? `${base}img/card/${f}`
                    : hasImg(`/img/hero/${f}`) ? `${base}img/hero/${f}` : null;
const skillIco = (id, slot) => hasImg(`/img/skill/${lc(id)}_${slot}.png`) ? `${base}img/skill/${lc(id)}_${slot}.png` : null;

const WMETA = Object.fromEntries(witches.map(w => [w.witch_id, w]));
const SKILLNAME = {};
for (const s of skills) SKILLNAME[`${s.witch_id}_${lc(s.slot)}`] = s.name;

const MAX_STATS = {
  'Arcanist_SR': { atk: 2499, cr: 0.3698, cd: 1.8488, ed: 0.0174 },
  'Arcanist_SSR': { atk: 3483, cr: 0.3978, cd: 1.9888, ed: 0.0759 },
  'Vanguard_SR': { atk: 2264, cr: 0.20, cd: 2.5968, ed: 0.0143 },
  'Vanguard_SSR': { atk: 3118, cr: 0.20, cd: 1.8768, ed: 0.0728 },
  'Defender_SR': { atk: 1170, cr: 0.20, cd: 1.00, ed: 0.0141 },
  'Defender_SSR': { atk: 1618, cr: 0.20, cd: 1.00, ed: 0.0141 },
  'Defender_UR': { atk: 1672, cr: 0.20, cd: 1.00, ed: 0.0141 },
  'Supporter_SR': { atk: 1637, cr: 0.20, cd: 1.00, ed: 0.0145 },
  'Supporter_SSR': { atk: 2300, cr: 0.20, cd: 1.00, ed: 0.0145 },
};
const W = Object.entries(engine.witches).map(([id, e]) => {
  const m = WMETA[id] || {};
  return { id, name: m.name, title: m.title || '', cls: e.cls, rar: e.rar, el: e.el, weak: e.weak,
    amp: e.amp, img: portraitOf(m.portrait_filename),
    skills: e.skills.map(s => ({ ...s, name: SKILLNAME[`${id}_${s.slot}`] || s.slot, ico: skillIco(id, s.slot) })) };
});
const carries = W.filter(w => w.cls === 'Arcanist' || w.cls === 'Vanguard').map(w => w.id);
const fillers = W.filter(w => w.cls === 'Supporter' || w.cls === 'Defender').map(w => w.id);
const UI = {};
for (const t of ['physical','mental','magic']) UI['type_' + t] = uiUrl('type_' + t);
for (const c of ['arcanist','vanguard','defender','supporter']) UI['cclass_' + c] = uiUrl('cclass_' + c);
for (const r of ['sr','ssr','ur']) UI['rarity_' + r] = uiUrl('rarity_' + r);
const BOSSES = [
  { id: 'venomfrill', name: 'Venomfrill', weak: 'physical', kd: 2.5 * 8 / 180 },
  { id: 'dummy', name: 'Test Dummy (no weakness / no knockdown)', weak: 'none', kd: 0 },
];
const RES = { vanguard: [13, 19, 25], arcanist: [14, 17, 20], mental: [20, 25, 30], physical: [4, 5, 6], magic: [4, 5, 6] };
const payload = { W, carries, fillers, MAX_STATS, UI, BOSSES, RES };
---
<Base title="DPS Solver — MAJO Codex" desc="Add the carries you've invested in and rank teams for your account.">
  <a class="back mono" href={base}>&larr; All witches</a>

  <section class="solver wrap">
    <header class="sv-head">
      <span class="eyebrow">Astrolabe Solver</span>
      <h1 class="display">Rank teams for <em>your</em> account</h1>
      <p class="sub">Add the Arcanists and Vanguards you've invested in with their current stats and skill levels.
        Supporters and Defenders fill the healer and utility slots at max, so you only track your carries. The board
        re-ranks live as you build your roster. Everything is saved to this browser — use <b>Copy link</b> to back up.</p>
    </header>

    <div class="lawbar panel">
      <div class="lb-boss">
        <span class="p-title mono">Boss</span>
        <select id="boss" class="field"></select>
      </div>
      <div class="lb-laws">
        <span class="p-title mono">Astrolabe laws</span>
        <div class="laws">
          <label class="law"><input type="checkbox" id="law_charge" checked><span>+20% charge <i class="mono">(S/A/V)</i></span></label>
          <label class="law"><input type="checkbox" id="law_start120" checked><span>+120 start</span></label>
          <span class="law-lv"><i>Vanguard</i><select id="law_van" class="field sm"></select></span>
          <span class="law-lv"><i>Arcanist</i><select id="law_arc" class="field sm"></select></span>
          <span class="law-lv"><i>Mental</i><select id="law_mental" class="field sm"></select></span>
          <span class="law-lv"><i>Physical</i><select id="law_physical" class="field sm"></select></span>
          <span class="law-lv"><i>Magic</i><select id="law_magic" class="field sm"></select></span>
        </div>
      </div>
    </div>

    <div class="sv-grid">
      <aside class="roster">
        <div class="roster-head">
          <span class="p-title mono">Your carries · <span id="poolCount">0</span></span>
          <button id="reset" class="btn ghost sm" type="button">Clear all</button>
        </div>
        <div id="pool" class="pool"></div>
        <button id="share" class="btn ghost" type="button">Copy shareable link</button>
      </aside>

      <div class="results">
        <div class="res-head">
          <span class="eyebrow">Recommended teams</span>
          <span id="resNote" class="mono note"></span>
        </div>
        <div id="board" class="board"></div>
      </div>
    </div>
  </section>

  <!-- add/edit modal -->
  <div id="modal" class="modal" hidden>
    <div class="modal-back" id="modalBack"></div>
    <div class="modal-card">
      <div class="modal-head">
        <span id="modalTitle" class="display">Add a carry</span>
        <button id="modalX" class="modal-x" type="button" aria-label="Close">&times;</button>
      </div>
      <div class="modal-body">
        <div class="m-row" id="mSelectRow">
          <label class="m-lbl mono">Witch</label>
          <select id="mWitch" class="field"></select>
        </div>
        <div class="m-info" id="mInfo"></div>
        <div class="m-stats">
          <label class="mf"><span class="mono">ATK</span><input id="mAtk" inputmode="decimal"></label>
          <label class="mf" id="mCrWrap"><span class="mono">Crit %</span><input id="mCr" inputmode="decimal"></label>
          <label class="mf"><span class="mono">Crit Dmg %</span><input id="mCd" inputmode="decimal"></label>
          <label class="mf"><span class="mono">Extra %</span><input id="mEd" inputmode="decimal"></label>
        </div>
        <div class="m-skills" id="mSkills"></div>
      </div>
      <div class="modal-foot">
        <button id="mRemove" class="btn ghost danger" type="button" hidden>Remove</button>
        <span class="spacer"></span>
        <button id="mCancel" class="btn ghost" type="button">Cancel</button>
        <button id="mSave" class="btn" type="button">Save</button>
      </div>
    </div>
  </div>

  <script type="application/json" id="sv-data" set:html={JSON.stringify(payload)}></script>

  <script>
    const DATA = JSON.parse(document.getElementById('sv-data').textContent);
    const { W, carries, fillers, MAX_STATS, UI, BOSSES, RES } = DATA;
    const CARRY = new Set(carries), FILLERS = fillers;
    const WMAP = new Map(W.map(w => [w.id, w]));
    const byId = id => WMAP.get(id);
    const CAP = s => s ? s[0].toUpperCase() + s.slice(1) : s;
    const lc = s => (s || '').toLowerCase();
    const $ = id => document.getElementById(id);
    const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));
    const lvLabel = v => v <= 7 ? `Lv ${v}` : `EX-${v - 7}`;
    const lvShort = v => v <= 7 ? `${v}` : `EX${v - 7}`;

    const defStats = w => ({ ...MAX_STATS[`${w.cls}_${w.rar}`] });
    const defLevels = w => Object.fromEntries(w.skills.map(s => [s.slot, s.maxlv]));
    const DEFAULT = () => ({ boss: 'venomfrill', units: {},
      laws: { charge: true, start120: true, van: 0, arc: 0, mental: 0, physical: 0, magic: 0 } });
    let S = load() || DEFAULT();

    function statsFor(id) {
      const w = byId(id);
      if (S.units[id]) return S.units[id];
      return { ...MAX_STATS[`${w.cls}_${w.rar}`], lv: defLevels(w) };
    }
    const owned = () => Object.keys(S.units).filter(id => CARRY.has(id));
    const teamPool = () => [...owned(), ...FILLERS];

    // ---------- timeline recompute ----------
    const T = 180;
    function timeline(id) {
      const w = byId(id), st = statsFor(id);
      const kn = st.atk * (1 + st.cr * st.cd) * (1 + st.ed);
      const ke = st.atk * (1 + 1.0 * st.cd) * (1 + st.ed);
      let ext = [], rest = [], normal = null;
      for (const s of w.skills) {
        const lv = clamp((st.lv && st.lv[s.slot]) || s.maxlv, 1, s.maxlv);
        const csum = (s.A + s.B * (lv - 1)) / 100;
        const D = (s.exec ? ke : kn) * csum, n = T / s.cad;
        if (s.slot === 'normal') normal = [D, s.anim];
        else if (s.slot === 'extreme') ext.push([D, s.anim, n, s.exec]);
        else rest.push([D, s.anim, n, s.exec]);
      }
      const eo = ext.reduce((a, x) => a + x[2] * x[1], 0);
      let extDmg = 0, execDmg = 0;
      for (const [D, an, n, e] of ext) { extDmg += n * D; if (e) execDmg += n * D; }
      const R1 = Math.max(0, T - eo), rd = rest.reduce((a, x) => a + x[2] * x[1], 0);
      const sc = rd ? Math.min(1, R1 / rd) : 1, restOcc = Math.min(rd, R1);
      let restDmg = 0;
      for (const [D, an, n, e] of rest) { const c = n * sc * D; restDmg += c; if (e) execDmg += c; }
      const left = Math.max(0, T - eo - restOcc);
      const nDmg = normal ? left / normal[1] * normal[0] : 0;
      const amp = w.amp || 1, total = (extDmg + restDmg + nDmg) * amp;
      return { total, extreme: total ? (extDmg * amp) / total : 0, normal: total ? (nDmg * amp) / total : 0, exec: total ? (execDmg * amp) / total : 0 };
    }
    const critMul = (st, add) => (1 + (st.cr + add) * st.cd) / (1 + st.cr * st.cd);
    const RAMP10 = 0.7, RAMP3 = 0.5;

    function lawMult(carry, team, boss, base) {
      const cw = byId(carry), st = statsFor(carry), why = [];
      const ex = base.exec, cls = {}, el = {};
      for (const t of team) { const w = byId(t); cls[w.cls] = (cls[w.cls]||0)+1; el[w.el] = (el[w.el]||0)+1; }
      let mult = 1;
      if ((cls.Arcanist||0) >= 2 && S.laws.arc > 0) {
        const add = RES.arcanist[S.laws.arc-1]/100, m = 1 + (1-ex) * (critMul(st, add) - 1);
        mult *= m; why.push(`2\u00d7 Arcanist crit \u2192 \u00d7${m.toFixed(2)}`);
      }
      let speed = 0;
      if ((cls.Vanguard||0) >= 2 && S.laws.van > 0) speed += RES.vanguard[S.laws.van-1]/100;
      if ((el[cw.el]||0) === 4) {
        if (cw.el==='physical' && S.laws.physical>0) speed += (RES.physical[S.laws.physical-1]/100)*10*RAMP10;
        if (cw.el==='magic' && S.laws.magic>0) speed += (RES.magic[S.laws.magic-1]/100)*10*RAMP10;
        if (cw.el==='mental' && S.laws.mental>0) speed += (RES.mental[S.laws.mental-1]/100)*3*RAMP3;
      }
      if (speed > 0) { const m = 1 + base.normal*speed; mult *= m; why.push(`+${Math.round(speed*100)}% atk speed \u2192 \u00d7${m.toFixed(2)}`); }
      let cf = 0;
      if (S.laws.charge && cls.Supporter && cls.Arcanist && cls.Vanguard) cf += 0.20;
      if ((el.magic||0) >= 2) cf += 0.10;
      if (cf > 0 || S.laws.start120) {
        const rate = 10*(1+cf), start = S.laws.start120 ? 120 : 0, freq = (start + rate*180)/1800;
        const m = 1 + base.extreme*(freq-1);
        if (m > 1.001) { mult *= m; why.push(`charge \u2192 \u00d7${m.toFixed(2)}`); }
      }
      if ((el.mental||0) >= 2 && boss.kd > 0) { const m = 1 + 0.25*boss.kd; mult *= m; why.push(`2\u00d7 Mental knockdown dmg \u2192 \u00d7${m.toFixed(2)}`); }
      if (boss.kd > 0) {
        const kd = (1 + 1.0*st.cd)/(1 + st.cr*st.cd), blend = (1-boss.kd) + boss.kd*kd, m = 1 + (1-ex)*(blend-1);
        if (m > 1.001) { mult *= m; why.push(`knockdown guaranteed-crit \u2192 \u00d7${m.toFixed(2)}`); }
      }
      return { mult, why };
    }
    const hasHealer = team => team.some(t => byId(t).cls === 'Supporter');
    let _t; const scheduleSolve = () => { clearTimeout(_t); _t = setTimeout(solve, 90); };

    function solve() {
      const own = owned();
      const boss = BOSSES.find(b => b.id === S.boss);
      if (!own.length) { renderEmpty(); return; }
      const ids = teamPool();
      const bases = new Map(ids.map(id => [id, timeline(id)]));
      const rows = [];
      for (const carry of own) {
        const base = bases.get(carry), weak = byId(carry).el === boss.weak ? 1 : 0.75;
        let best = null;
        for (let i = 0; i < ids.length; i++) {
          if (ids[i] === carry) continue;
          for (let j = i+1; j < ids.length; j++) {
            if (ids[j] === carry) continue;
            for (let k = j+1; k < ids.length; k++) {
              if (ids[k] === carry) continue;
              const team = [carry, ids[i], ids[j], ids[k]];
              if (!hasHealer(team)) continue;
              const { mult, why } = lawMult(carry, team, boss, base);
              const eff = base.total * weak * mult;
              if (!best || eff > best.eff) best = { eff, team, why, weak };
            }
          }
        }
        if (best) rows.push({ carry, ...best });
      }
      rows.sort((a, b) => b.eff - a.eff);
      render(rows, boss);
    }

    // ---------- render ----------
    const elC = e => `type-${e}`;
    function renderEmpty() {
      $('resNote').textContent = '';
      $('board').innerHTML = `<div class="empty"><p>No carries yet.</p>
        <p class="mono">Add an Arcanist or Vanguard to see the teams that rank best for your account.</p></div>`;
    }
    function render(rows, boss) {
      const top = rows[0]?.eff || 1;
      $('resNote').textContent = `vs ${boss.name} \u00b7 relative to top`;
      $('board').innerHTML = rows.map((r, i) => {
        const cw = byId(r.carry);
        const mates = r.team.filter(t => t !== r.carry).map(t => {
          const m = byId(t);
          return `<span class="mate"><b>${m.name}</b><i class="${elC(m.el)}">${m.cls}</i></span>`;
        }).join('');
        const why = r.why.map(x => `<li>${x}</li>`).join('');
        const pct = Math.round(r.eff / top * 100);
        return `<article class="comp${i===0?' top':''}">
          <div class="comp-rank mono">#${i+1}</div>
          <div class="comp-body">
            <div class="comp-carry"><span class="c-name display">${cw.name}</span>
              <span class="rarity-chip is-${cw.rar}">${cw.rar}</span>
              <span class="c-tag ${elC(cw.el)} mono">${CAP(cw.el)} ${cw.cls}</span>
              ${r.weak < 1 ? '<span class="offweak mono">off-weakness \u00d7.75</span>' : ''}</div>
            <div class="comp-team">${mates}</div>
            <ul class="comp-why mono">${why}</ul></div>
          <div class="comp-score"><span class="s-val">${pct}</span><span class="s-bar"><i style="width:${pct}%"></i></span></div>
        </article>`;
      }).join('');
    }

    // ---------- pool tiles ----------
    function typeIco(t, title) {
      return UI['type_' + lc(t)]
        ? `<img class="tico" src="${UI['type_'+lc(t)]}" alt="${title}" title="${title}" width="20" height="20">`
        : `<span class="tico txt ${elC(lc(t))}" title="${title}">${CAP(t)[0]}</span>`;
    }
    function renderPool() {
      const ids = owned();
      $('poolCount').textContent = ids.length;
      const add = `<button class="tile add" id="addTile" type="button">
        <span class="plus">+</span><span class="mono">Add my Witch</span></button>`;
      $('pool').innerHTML = ids.map(id => {
        const w = byId(id), st = S.units[id];
        const cls = UI['cclass_' + lc(w.cls)]
          ? `<img class="cclass" src="${UI['cclass_'+lc(w.cls)]}" alt="${w.cls}" title="${w.cls}" width="30" height="30">`
          : `<span class="cclass txt">${w.cls[0]}</span>`;
        const rar = UI['rarity_' + lc(w.rar)]
          ? `<img class="rar" src="${UI['rarity_'+lc(w.rar)]}" alt="${w.rar}" height="24">`
          : `<span class="rarity-chip is-${w.rar}">${w.rar}</span>`;
        const port = w.img
          ? `<img class="portrait-img" src="${w.img}" alt="${w.name}" loading="lazy">`
          : `<svg viewBox="0 0 24 24" class="sigil"><path d="M2 12 C6 5.5, 18 5.5, 22 12 C18 18.5, 6 18.5, 2 12 Z" fill="none" stroke="currentColor" stroke-width="1"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1"/><circle cx="12" cy="12" r="1.3" fill="currentColor"/></svg>`;
        const crCell = w.cls === 'Arcanist' ? `<span><b>${(st.cr*100).toFixed(1)}</b>cr</span>` : '';
        const stats = `<div class="tstats mono">
          <span><b>${st.atk}</b>atk</span>${crCell}
          <span><b>${(st.cd*100).toFixed(0)}</b>cd</span>
          <span><b>${(st.ed*100).toFixed(1)}</b>ed</span></div>`;
        const sk = w.skills.map(s => {
          const v = st.lv[s.slot], ex = v > 7;
          const face = s.ico ? `<img src="${s.ico}" alt="${s.slot}">` : `<i>${s.slot[0].toUpperCase()}</i>`;
          return `<span class="sk${ex?' ex':''}" title="${s.name} \u00b7 ${lvLabel(v)}">${face}<b>${lvShort(v)}</b></span>`;
        }).join('');
        return `<div class="tile rar-${w.rar}" data-id="${id}">
          <div class="tportrait">${cls}${port}
            <div class="tbadges">${typeIco(w.el,CAP(w.el)+' damage')}${rar}${typeIco(w.weak,'Weak to '+CAP(w.weak))}</div></div>
          <div class="tfoot">
            <div class="tname"><span class="display">${w.name}</span>
              <button class="edit mono" data-edit="${id}" type="button">Edit</button></div>
            ${stats}<div class="tskills">${sk}</div>
          </div></div>`;
      }).join('') + add;
      $('addTile').addEventListener('click', () => openModal(null));
      $('pool').querySelectorAll('[data-edit]').forEach(b => b.addEventListener('click', () => openModal(b.dataset.edit)));
    }

    // ---------- modal ----------
    let editing = null;
    function openModal(id) {
      editing = id;
      $('modalTitle').textContent = id ? `Edit ${byId(id).name}` : 'Add a carry';
      $('mRemove').hidden = !id;
      const sel = $('mWitch'), selRow = $('mSelectRow');
      if (id) { selRow.hidden = true; buildModalBody(id, statsFor(id)); }
      else {
        selRow.hidden = false;
        const avail = carries.filter(c => !S.units[c]);
        sel.innerHTML = avail.map(c => `<option value="${c}">${byId(c).name} \u00b7 ${byId(c).cls} ${byId(c).rar}</option>`).join('');
        if (!avail.length) { sel.innerHTML = '<option>All carries added</option>'; }
        const first = avail[0];
        if (first) buildModalBody(first, { ...defStats(byId(first)), lv: defLevels(byId(first)) });
      }
      $('modal').hidden = false;
    }
    function buildModalBody(id, st) {
      const w = byId(id);
      $('mInfo').innerHTML = `<span class="chip mono">${w.cls}</span>
        <span class="chip mono ${elC(w.el)}">${CAP(w.el)} dmg</span>
        <span class="chip mono ${elC(w.weak)}">Weak: ${CAP(w.weak)}</span>
        <span class="rarity-chip is-${w.rar}">${w.rar}</span>`;
      $('mAtk').value = st.atk;
      $('mCr').value = (st.cr*100).toFixed(2); $('mCd').value = (st.cd*100).toFixed(2); $('mEd').value = (st.ed*100).toFixed(2);
      $('mCrWrap').style.display = w.cls === 'Arcanist' ? '' : 'none';
      $('mSkills').innerHTML = w.skills.map(s => {
        const v = (st.lv && st.lv[s.slot]) || s.maxlv;
        const face = s.ico ? `<img class="ms-ico" src="${s.ico}" alt="">` : `<span class="ms-ico txt">${s.slot[0].toUpperCase()}</span>`;
        return `<div class="mskill"><div class="ms-top">${face}<span class="ms-name">${s.name}</span>
          <span class="ms-lv mono" id="lbl_${s.slot}">${lvLabel(v)}</span></div>
          <input type="range" min="1" max="${s.maxlv}" value="${v}" data-slot="${s.slot}" class="slider"></div>`;
      }).join('');
      $('mSkills').querySelectorAll('.slider').forEach(sl => sl.addEventListener('input', () => {
        $('lbl_' + sl.dataset.slot).textContent = lvLabel(+sl.value);
      }));
      $('mWitch').onchange = () => { const nid = $('mWitch').value; buildModalBody(nid, { ...defStats(byId(nid)), lv: defLevels(byId(nid)) }); };
    }
    function readModal() {
      const id = editing || $('mWitch').value, w = byId(id);
      const num = (el, d) => { const v = parseFloat($(el).value); return isNaN(v) ? d : v; };
      const lv = {};
      $('mSkills').querySelectorAll('.slider').forEach(sl => lv[sl.dataset.slot] = +sl.value);
      const cr = w.cls === 'Arcanist' ? num('mCr', 20)/100 : MAX_STATS[`${w.cls}_${w.rar}`].cr;
      return { id, unit: { atk: num('mAtk', 0), cr, cd: num('mCd', 0)/100, ed: num('mEd', 0)/100, lv } };
    }
    const closeModal = () => { $('modal').hidden = true; editing = null; };

    // ---------- selects / laws ----------
    function fillSelects() {
      $('boss').innerHTML = BOSSES.map(b => `<option value="${b.id}">${b.name}</option>`).join('');
      $('boss').value = S.boss;
      const opts = l => `<option value="0">off</option>` + l.map((v,i)=>`<option value="${i+1}">Lv${i+1} \u00b7 ${v}%</option>`).join('');
      $('law_van').innerHTML = opts(RES.vanguard); $('law_arc').innerHTML = opts(RES.arcanist);
      $('law_mental').innerHTML = opts(RES.mental); $('law_physical').innerHTML = opts(RES.physical); $('law_magic').innerHTML = opts(RES.magic);
      $('law_charge').checked = S.laws.charge; $('law_start120').checked = S.laws.start120;
      for (const k of ['van','arc','mental','physical','magic']) $('law_'+k).value = S.laws[k];
    }
    function wire() {
      $('boss').addEventListener('change', e => { S.boss = e.target.value; save(); solve(); });
      $('law_charge').addEventListener('change', e => { S.laws.charge = e.target.checked; save(); solve(); });
      $('law_start120').addEventListener('change', e => { S.laws.start120 = e.target.checked; save(); solve(); });
      for (const k of ['van','arc','mental','physical','magic'])
        $('law_'+k).addEventListener('change', e => { S.laws[k] = +e.target.value; save(); solve(); });
      $('reset').addEventListener('click', () => { if (confirm('Remove all carries?')) { S.units = {}; save(); renderPool(); solve(); } });
      $('share').addEventListener('click', () => {
        const url = location.origin + location.pathname + '#' + btoa(encodeURIComponent(JSON.stringify(S)));
        navigator.clipboard.writeText(url).then(() => { const b=$('share'),t=b.textContent; b.textContent='Copied \u2713'; setTimeout(()=>b.textContent=t,1400); });
      });
      $('mSave').addEventListener('click', () => { const { id, unit } = readModal(); S.units[id] = unit; save(); closeModal(); renderPool(); solve(); });
      $('mCancel').addEventListener('click', closeModal);
      $('modalX').addEventListener('click', closeModal);
      $('modalBack').addEventListener('click', closeModal);
      $('mRemove').addEventListener('click', () => { if (editing) { delete S.units[editing]; save(); closeModal(); renderPool(); solve(); } });
    }
    function save() { try { localStorage.setItem('majo-solver-v3', JSON.stringify(S)); } catch {} }
    function load() {
      try {
        if (location.hash.length > 1) { const h = JSON.parse(decodeURIComponent(atob(location.hash.slice(1)))); if (h.units) return h; }
        const raw = localStorage.getItem('majo-solver-v3'); return raw ? JSON.parse(raw) : null;
      } catch { return null; }
    }

    fillSelects(); wire(); renderPool(); solve();
  </script>

