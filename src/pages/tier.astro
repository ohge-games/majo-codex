---
import Base from '../layouts/Base.astro';
import EyeBadge from '../components/EyeBadge.astro';
import witches from '../data/witches.json';
import guides from '../data/guides.json';
import skillScores from '../data/skill_scores.json';
import tierSynergy from '../data/tier_synergy.json';
import suggestedComps from '../data/suggested_comps.json';
import fs from 'node:fs';

const base = import.meta.env.BASE_URL;
const lc = s => (s ?? '').toLowerCase();
const cap = s => s ? s[0].toUpperCase() + s.slice(1) : s;
const ui = name => `${base}img/ui/${name}.png`;
const hasImg = p => { try { return fs.existsSync(`${process.cwd()}/public${p}`); } catch { return false; } };
const hasUi = name => hasImg(`/img/ui/${name}.png`);
const wById = Object.fromEntries(witches.map(w => [w.witch_id, w]));
const accentVar = t => ({physical:'var(--physical)',magic:'var(--magic)',mental:'var(--mental)'}[lc(t)] || 'var(--sigil)');
const dealersByType = t => witches.filter(w => w.damage_type === t)
  .sort((a, b) => (a.rarity === 'SSR' ? 0 : 1) - (b.rarity === 'SSR' ? 0 : 1) || a.name.localeCompare(b.name));
const synById = Object.fromEntries((tierSynergy.witches || []).map(sy => [sy.witch_id, sy]));
const scoreOf = wid => { const ob = skillScores.witches?.[wid]?.overall_by_rank; return ob ? Math.max(...Object.values(ob)) : 0; };
const TEAM_TAGS = new Set(['team-buff-aura','counter-enabler','charge-amp','extreme-battery','extreme-charger']);
const rankedDealers = (weak) => {
  const list = witches.filter(w => w.damage_type === weak).map(w => {
    const sy = synById[w.witch_id] || {};
    const wx = (sy.debuffs || []).includes('weakness-exploit');
    const teamBuff = wx || (sy.role_tags || []).some(t => TEAM_TAGS.has(t));
    return { w, score: scoreOf(w.witch_id), teamBuff, wx };
  }).sort((a, b) => b.score - a.score);
  const max = Math.max(1, ...list.map(d => d.score));
  return list.map(d => ({ ...d, pct: Math.round(100 * d.score / max) }));
};
const compsFor = id => (suggestedComps[id]?.comps || []);
const shortRes = r => r.split('->')[0].replace(':', '').trim();
const bossMedia = (b) => {
  // Converted showcase loop under /vid/boss/ wins (b.video = file stem, e.g. "boss_venomfrill_lobby").
  if (b.video) {
    const wp = `/vid/boss/${b.video}.webp`;
    const vposter = hasImg(wp) ? `${base}${wp.slice(1)}` : null;
    for (const ext of ['mp4', 'webm']) {
      const vp = `/vid/boss/${b.video}.${ext}`;
      if (hasImg(vp)) return { type: 'video', ext, src: `${base}${vp.slice(1)}`, poster: vposter };
    }
  }
  const stems = [b.media, b.id].filter(Boolean);
  const poster = [b.media, b.id].filter(Boolean).flatMap(st => [`/img/boss/${st}.png`, `/img/boss/${st}.jpg`]).map(x => hasImg(x) ? `${base}${x.slice(1)}` : null).find(Boolean) || null;
  for (const stem of stems) {
    for (const ext of ['mp4', 'webm']) { const p = `/img/boss/${stem}.${ext}`; if (hasImg(p)) return { type: 'video', ext, src: `${base}${p.slice(1)}`, poster }; }
    const gp = `/img/boss/${stem}.gif`; if (hasImg(gp)) return { type: 'gif', src: `${base}${gp.slice(1)}` };
  }
  return poster ? { type: 'img', src: poster } : null;
};
---
<Base title="Training Boss — MAJO Codex" desc="Team guidance for the current Training Boss: mechanics, counters, and damage-ranked dealers.">
  <div class="wrap tier">
    <header class="thead">
      <h1 class="display">Training Boss</h1>
      <p class="sub">Mechanics, counters, and damage-ranked dealers for the <b>current Training Boss</b>. Tower of Anomaly floor guidance returns once the data is ready.</p>
    </header>

    <section class="mode">
      <h2 class="sec display">Boss Training</h2>
      {guides.bosses.map(b => (
        <article class="boss" style={`--accent:${accentVar(b.deals)};--weak-accent:${accentVar(b.weak)}`}>
          <div class="boss-head">
            <div class="boss-art">
              {(() => { const m = bossMedia(b); return m
                ? (m.type === 'video'
                    ? <video class="boss-media" autoplay loop muted playsinline poster={m.poster || undefined}><source src={m.src} type={`video/${m.ext}`} /></video>
                    : <img class="boss-media" src={m.src} alt={b.name} />)
                : <span class="boss-ph" aria-hidden="true"></span>; })()}
              <span class="boss-frame" aria-hidden="true"></span>
            </div>
            <div class="boss-meta">
              <span class="mode-tag mono">{b.mode}</span>{b.upcoming && <span class="up-tag mono">Upcoming</span>}
              {b.full_name && <span class="boss-full">{b.full_name}</span>}
              <h3 class="boss-name">{b.name}</h3>
              <p class="boss-blurb">{b.blurb}</p>
              {b.ranks && b.ranks.length > 0 && (
                <div class="ranks">
                  <span class="dl mono">HP by rank</span>
                  <div class="rank-grid mono">
                    {b.ranks.map(r => (
                      <div class="rank-cell">
                        <span class="rk">Rank {r.rank}{r.endless ? ' · Endless' : ''}</span>
                        <span class="rk-hp">{r.hp.toLocaleString()}</span>
                        <span class="rk-pw">rec {r.rec_power}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}
              <div class="type-row">
                <span class="tchip">{hasUi(`type_${lc(b.deals)}`) ? <img class="tic" src={ui(`type_${lc(b.deals)}`)} width="20" height="20" alt="" /> : <EyeBadge type={b.deals} size={20} title="" />} <span><b>{cap(b.deals)}</b> damage</span></span>
                <span class="tchip weak">{hasUi(`type_${lc(b.weak)}`) ? <img class="tic" src={ui(`type_${lc(b.weak)}`)} width="20" height="20" alt="" /> : <EyeBadge type={b.weak} size={20} title="" />} <span>Weak to <b>{cap(b.weak)}</b></span></span>
                {b.race && <span class="tchip"><span>Race: <b>{cap(b.race)}</b></span></span>}
              </div>
            </div>
          </div>

          <div class="boss-body">
            <div class="col">
              {b.mechanics && b.mechanics.length > 0 && (<>
                <span class="dl mono">Mechanics &amp; counters</span>
                {b.mechanics.map(m => (
                  <div class="mech"><b>{m.name}.</b> {m.text}</div>
                ))}
              </>)}
              {b.control && b.control.length > 0 && (
                <>
                  <span class="dl mono" style="margin-top:16px">Control for the Wake-up Kickback</span>
                  <div class="recs">
                    {b.control.map(r => { const w = wById[r.witch_id]; return w ? (
                      <a class="rec" href={`${base}witch/${w.witch_id.toLowerCase()}`}>
                        <span class={`rdot is-${w.rarity}`}></span>
                        <span class="rname">{w.name}</span>
                        <span class="rnote">{r.note}</span>
                      </a>) : null; })}
                  </div>
                </>
              )}
            </div>
            <div class="col">
              <span class="dl mono">Pro tips</span>
              <ul class="tips">{b.tips.map(t => <li>{t}</li>)}</ul>
              {(b.recommended || []).length > 0 && (
                <>
                  <span class="dl mono">Recommended</span>
                  <div class="recs">
                    {b.recommended.map(r => {
                      const w = wById[r.witch_id];
                      return w ? (
                        <a class="rec" href={`${base}witch/${w.witch_id.toLowerCase()}`}>
                          <span class={`rdot is-${w.rarity}`}></span>
                          <span class="rname">{w.name}</span>
                          <span class="rnote">{r.note}</span>
                        </a>
                      ) : null;
                    })}
                  </div>
                </>
              )}
              <span class="dl mono" style="margin-top:16px">{cap(b.weak)} dealers, ranked <span class="auto-note">(weak to {cap(b.weak)})</span></span>
              <p class="rank-cap mono">By single-unit damage · team-law weighting in progress</p>
              <div class="drank">
                {rankedDealers(b.weak).map((d, i) => (
                  <a class={`drow is-${d.w.rarity}`} href={`${base}witch/${d.w.witch_id.toLowerCase()}`}>
                    <span class="dr-rank mono">{i + 1}</span>
                    <span class="dr-main">
                      <span class="dr-line1">
                        <span class={`dr-dot is-${d.w.rarity}`}></span>
                        <span class="dr-name">{d.w.name}</span>
                        <span class="dr-meta mono">{d.w.rarity} · {d.w.class}</span>
                        {d.teamBuff && <span class="dr-buff mono" title="Buffs the team">{d.wx ? 'weakness-exploit' : 'team buff'}</span>}
                      </span>
                      <span class="dr-bar"><span class="dr-fill" style={`width:${d.pct}%`}></span></span>
                    </span>
                    <span class="dr-score mono">{d.score ? Math.round(d.score) : '—'}</span>
                  </a>
                ))}
              </div>
            </div>
          </div>

          {compsFor(b.id).length > 0 && (
            <div class="comps">
              <span class="dl mono">Suggested teams <span class="auto-note">(damage × weakness × Laws × survivability · provisional)</span></span>
              <div class="comp-list">
                {compsFor(b.id).slice(0, 5).map(c => (
                  <div class={`comp ${c.weakness_mult < 1 ? 'off-weak' : ''}`}>
                    <div class="comp-score">
                      <span class="comp-rank mono">#{c.rank}</span>
                      <span class="comp-eff">{Math.round(c.effective_score)}</span>
                      <span class="comp-mult mono">Laws ×{c.law_mult.toFixed(2)}</span>
                      {c.weakness_mult < 1 && <span class="comp-offw mono">off-weakness</span>}
                    </div>
                    <div class="comp-body">
                      <div class="comp-team">
                        {c.team_ids.map(id => { const w = wById[id]; const carry = id === c.carry_id; return w ? (
                          <a class={`comp-unit is-${w.rarity} ${carry ? 'is-carry' : ''}`} href={`${base}witch/${id.toLowerCase()}`}>
                            <span class={`cu-dot is-${w.rarity}`}></span>
                            <span class="cu-name">{w.name}</span>
                            {carry && <span class="cu-tag mono">carry</span>}
                          </a>) : null; })}
                      </div>
                      <div class="comp-res">
                        {c.resonances.map(r => <span class="res-tag mono">{shortRes(r)}</span>)}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </article>
      ))}
    </section>

    {guides.past_bosses && guides.past_bosses.length > 0 && (
      <section class="past">
        <details>
          <summary class="mono">Previous bosses ({guides.past_bosses.length})</summary>
          {guides.past_bosses.map(b => (
            <div class="past-boss">
              <h3 class="past-name">{b.name} <span class="mono past-tag">rotated out</span></h3>
              {b.mechanics && b.mechanics.map(m => <p class="past-mech"><b>{m.name}:</b> {m.text}</p>)}
            </div>
          ))}
        </details>
      </section>
    )}

  </div>
</Base>

<style>
  .tier{padding:28px 24px 64px}
  .thead h1{font-size:clamp(2rem,5vw,3rem);margin:0 0 6px}
  .thead .sub{color:var(--ink-dim);max-width:60ch;margin:0 0 8px}
  .sec{font-size:1.5rem;margin:36px 0 16px}
  .mode-tag{font-size:.62rem;letter-spacing:.16em;text-transform:uppercase;color:var(--sigil)}
  .up-tag{margin-left:8px;font-size:.58rem;letter-spacing:.12em;text-transform:uppercase;color:#1c1406;background:linear-gradient(180deg,#ffe08a,var(--ssr));border-radius:6px;padding:2px 7px}
  .boss{background:var(--veil);border:1px solid var(--line);border-radius:var(--r);overflow:hidden}
  .boss-head{display:flex;gap:24px;padding:22px 24px;align-items:flex-start;
    background:radial-gradient(680px 300px at 0% 0%, color-mix(in srgb,var(--accent,#8b6cff) 15%,transparent), transparent 72%)}
  /* Specimen feed: tall 3:4 portrait framed like a monitored anomaly */
  .boss-art{position:relative;width:clamp(168px,23vw,248px);aspect-ratio:3/4;flex-shrink:0;
    border-radius:12px;overflow:hidden;display:grid;place-items:center;background:var(--nightshade);
    border:1px solid color-mix(in srgb,var(--accent,#8b6cff) 38%,var(--line));
    box-shadow:inset 0 0 70px -22px color-mix(in srgb,var(--accent,#8b6cff) 60%,transparent), 0 14px 40px -18px rgba(0,0,0,.75)}
  .boss-art img,.boss-art .boss-media{width:100%;height:100%;object-fit:cover;display:block}
  .boss-ph{width:52%;aspect-ratio:1;border-radius:50%;
    background:radial-gradient(circle at 40% 35%, color-mix(in srgb,var(--accent,#8b6cff) 40%,#23261a), #191325);opacity:.7}
  .boss-frame{position:absolute;inset:9px;pointer-events:none;border-radius:4px;
    border:1.5px solid color-mix(in srgb,var(--accent,#8b6cff) 78%,#ffffff 8%);
    -webkit-mask:
      linear-gradient(#000 0 0) top left/16px 16px no-repeat,
      linear-gradient(#000 0 0) top right/16px 16px no-repeat,
      linear-gradient(#000 0 0) bottom left/16px 16px no-repeat,
      linear-gradient(#000 0 0) bottom right/16px 16px no-repeat;
    mask:
      linear-gradient(#000 0 0) top left/16px 16px no-repeat,
      linear-gradient(#000 0 0) top right/16px 16px no-repeat,
      linear-gradient(#000 0 0) bottom left/16px 16px no-repeat,
      linear-gradient(#000 0 0) bottom right/16px 16px no-repeat}
  .boss-name{font-size:1.6rem;margin:4px 0 6px}
  .boss-blurb{color:var(--ink-dim);margin:0 0 10px;font-size:.92rem;max-width:56ch}
  .type-row{display:flex;flex-wrap:wrap;gap:10px}
  .tchip{display:inline-flex;align-items:center;gap:8px;background:rgba(20,16,32,.7);border:1px solid var(--line);
    border-radius:10px;padding:6px 11px;font-size:.86rem;color:var(--ink-dim)}
  .tchip b{color:var(--ink)}
  .tchip .tic{display:block}
  .boss-source{font-size:.66rem;color:var(--ink-faint);margin:0 0 10px}
  .tchip.weak{box-shadow:inset 0 0 0 1px color-mix(in srgb,#e0574b 40%,transparent)}
  .boss-body{display:grid;grid-template-columns:1fr 1fr;gap:22px;padding:20px 22px;border-top:1px solid var(--line)}
  .dl{display:block;font-size:.62rem;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-faint);margin-bottom:10px}
  .mech{background:var(--nightshade);border:1px solid var(--line);border-radius:9px;padding:11px 13px;margin-bottom:9px;font-size:.9rem;color:var(--ink-dim);line-height:1.5}
  .mech b{color:var(--ink)}
  .tips{margin:0;padding-left:18px;color:var(--ink-dim);font-size:.88rem;line-height:1.6}
  .recs{display:flex;flex-direction:column;gap:8px}
  .rec{display:grid;grid-template-columns:auto auto 1fr;align-items:baseline;gap:9px;text-decoration:none;
    background:var(--nightshade);border:1px solid var(--line);border-radius:9px;padding:10px 13px}
  .rec:hover{border-color:color-mix(in srgb,var(--sigil) 45%,var(--line))}
  .rdot{width:9px;height:9px;border-radius:50%;background:var(--ink-faint)}
  .rdot.is-SSR{background:var(--ssr)} .rdot.is-SR{background:var(--sr)}
  .rname{color:var(--ink);font-weight:600;font-size:.95rem}
  .rnote{color:var(--ink-faint);font-size:.82rem}
  .auto-note{color:var(--ink-faint);font-size:.66rem;letter-spacing:0;text-transform:none}
  .dealer-chips{display:flex;flex-wrap:wrap;gap:7px}
  .dchip2{display:inline-flex;align-items:center;gap:6px;text-decoration:none;font-size:.82rem;color:var(--ink-dim);
    background:var(--nightshade);border:1px solid var(--line);border-radius:999px;padding:5px 11px}
  .dchip2:hover{border-color:color-mix(in srgb,var(--sigil) 45%,var(--line));color:var(--ink)}
  .dc-dot{width:7px;height:7px;border-radius:50%;background:var(--ink-faint)}
  .dchip2.is-SSR .dc-dot{background:var(--ssr)} .dchip2.is-SR .dc-dot{background:var(--sr)}
  .dc-r{font-size:.6rem;color:var(--ink-faint)}
  .ranks{margin:12px 0 4px}
  .rank-grid{display:flex;flex-wrap:wrap;gap:8px;margin-top:6px}
  .rank-cell{display:flex;flex-direction:column;gap:1px;background:var(--nightshade);border:1px solid var(--line);
    border-radius:8px;padding:6px 11px;min-width:96px}
  .rank-cell .rk{font-size:.62rem;color:var(--ink-faint)}
  .rank-cell .rk-hp{font-size:.95rem;color:var(--ink);font-weight:700}
  .rank-cell .rk-pw{font-size:.6rem;color:var(--ink-faint)}
  .boss-full{display:block;font-size:.66rem;letter-spacing:.06em;color:var(--ink-faint);margin-top:2px}
  .past{padding:0 20px 40px;max-width:var(--maxw,1100px);margin:0 auto}
  .past summary{cursor:pointer;color:var(--ink-faint);font-size:.8rem;letter-spacing:.04em}
  .past-boss{margin:12px 0;padding:12px 14px;background:var(--veil);border:1px solid var(--line);border-radius:var(--r);opacity:.75}
  .past-name{margin:0 0 6px;font-size:1rem}
  .past-tag{font-size:.58rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-faint);border:1px solid var(--line);border-radius:5px;padding:1px 6px}
  .past-mech{font-size:.82rem;color:var(--ink-dim);margin:4px 0}
  .tower-empty{background:var(--veil);border:1px dashed var(--line);border-radius:var(--r);padding:22px;color:var(--ink-dim)}
  .auto-note{color:var(--ink-faint);font-size:.66rem;letter-spacing:0;text-transform:none}
  .dealer-chips{display:flex;flex-wrap:wrap;gap:7px}
  .dchip2{display:inline-flex;align-items:center;gap:6px;text-decoration:none;font-size:.82rem;color:var(--ink-dim);
    background:var(--nightshade);border:1px solid var(--line);border-radius:999px;padding:5px 11px}
  .dchip2:hover{border-color:color-mix(in srgb,var(--sigil) 45%,var(--line));color:var(--ink)}
  .dc-dot{width:7px;height:7px;border-radius:50%;background:var(--ink-faint)}
  .dchip2.is-SSR .dc-dot{background:var(--ssr)} .dchip2.is-SR .dc-dot{background:var(--sr)}
  .dc-r{font-size:.6rem;color:var(--ink-faint)}
  .tower-empty .hint{color:var(--ink-faint);font-size:.78rem;margin-bottom:0}
  .rank-cap{font-size:.6rem;color:var(--ink-faint);letter-spacing:.04em;margin:-4px 0 10px}
  .drank{display:flex;flex-direction:column;gap:7px}
  .drow{display:grid;grid-template-columns:20px 1fr auto;align-items:center;gap:11px;text-decoration:none;
    background:var(--nightshade);border:1px solid var(--line);border-radius:9px;padding:9px 12px}
  .drow:hover{border-color:color-mix(in srgb,var(--sigil) 45%,var(--line))}
  .dr-rank{font-size:.78rem;color:var(--ink-faint);text-align:center}
  .dr-main{display:flex;flex-direction:column;gap:6px;min-width:0}
  .dr-line1{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
  .dr-dot{width:8px;height:8px;border-radius:50%;background:var(--ink-faint);flex-shrink:0}
  .dr-dot.is-SSR{background:var(--ssr)} .dr-dot.is-SR{background:var(--sr)}
  .dr-name{color:var(--ink);font-weight:600;font-size:.92rem}
  .dr-meta{font-size:.62rem;color:var(--ink-faint)}
  .dr-buff{font-size:.56rem;letter-spacing:.04em;text-transform:uppercase;
    color:var(--weak-accent,var(--sigil));border:1px solid color-mix(in srgb,var(--weak-accent,var(--sigil)) 40%,var(--line));
    border-radius:5px;padding:1px 6px}
  .dr-bar{height:5px;border-radius:999px;background:color-mix(in srgb,var(--line) 80%,transparent);overflow:hidden}
  .dr-fill{display:block;height:100%;border-radius:999px;
    background:linear-gradient(90deg, color-mix(in srgb,var(--weak-accent,var(--sigil)) 45%,transparent), var(--weak-accent,var(--sigil)))}
  .dr-score{font-size:.86rem;color:var(--ink);font-weight:700;min-width:26px;text-align:right}
  .comps{padding:20px 22px;border-top:1px solid var(--line)}
  .comp-list{display:flex;flex-direction:column;gap:10px}
  .comp{display:grid;grid-template-columns:118px 1fr;gap:16px;align-items:center;
    background:var(--nightshade);border:1px solid var(--line);border-radius:11px;padding:13px 15px}
  .comp.off-weak{opacity:.82}
  .comp-score{display:flex;flex-direction:column;align-items:flex-start;gap:2px;
    border-right:1px solid var(--line);padding-right:12px}
  .comp-rank{font-size:.62rem;color:var(--ink-faint)}
  .comp-eff{font-size:1.5rem;font-weight:800;line-height:1;color:var(--ink);
    font-family:"Space Mono",monospace}
  .comp-mult{font-size:.6rem;color:var(--weak-accent,var(--sigil));margin-top:3px}
  .comp-offw{font-size:.56rem;letter-spacing:.04em;text-transform:uppercase;color:var(--ink-faint);
    border:1px solid var(--line);border-radius:5px;padding:1px 5px;margin-top:3px}
  .comp-body{display:flex;flex-direction:column;gap:9px;min-width:0}
  .comp-team{display:flex;flex-wrap:wrap;gap:7px}
  .comp-unit{display:inline-flex;align-items:center;gap:7px;text-decoration:none;font-size:.86rem;color:var(--ink-dim);
    background:var(--veil);border:1px solid var(--line);border-radius:999px;padding:5px 11px}
  .comp-unit:hover{border-color:color-mix(in srgb,var(--sigil) 45%,var(--line));color:var(--ink)}
  .comp-unit.is-carry{color:var(--ink);border-color:color-mix(in srgb,var(--weak-accent,var(--sigil)) 55%,var(--line));
    background:color-mix(in srgb,var(--weak-accent,var(--sigil)) 12%,var(--veil))}
  .cu-dot{width:7px;height:7px;border-radius:50%;background:var(--ink-faint);flex-shrink:0}
