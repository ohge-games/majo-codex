---
import Base from '../layouts/Base.astro';
import EyeBadge from '../components/EyeBadge.astro';
import witches from '../data/witches.json';
import guides from '../data/guides.json';
import fs from 'node:fs';

const base = import.meta.env.BASE_URL;
const lc = s => (s ?? '').toLowerCase();
const cap = s => s ? s[0].toUpperCase() + s.slice(1) : s;
const ui = name => `${base}img/ui/${name}.png`;
const hasImg = p => { try { return fs.existsSync(`${process.cwd()}/public${p}`); } catch { return false; } };
const hasUi = name => hasImg(`/img/ui/${name}.png`);
const wById = Object.fromEntries(witches.map(w => [w.witch_id, w]));
const dealersByType = t => witches.filter(w => w.damage_type === t)
  .sort((a, b) => (a.rarity === 'SSR' ? 0 : 1) - (b.rarity === 'SSR' ? 0 : 1) || a.name.localeCompare(b.name));
const bossMedia = (b) => {
  const stems = [b.media, b.id].filter(Boolean);
  const poster = [b.media, b.id].filter(Boolean).flatMap(st => [`/img/boss/${st}.png`, `/img/boss/${st}.jpg`]).map(x => hasImg(x) ? `${base}${x.slice(1)}` : null).find(Boolean) || null;
  for (const stem of stems) {
    for (const ext of ['mp4', 'webm']) { const p = `/img/boss/${stem}.${ext}`; if (hasImg(p)) return { type: 'video', ext, src: `${base}${p.slice(1)}`, poster }; }
    const gp = `/img/boss/${stem}.gif`; if (hasImg(gp)) return { type: 'gif', src: `${base}${gp.slice(1)}` };
  }
  return poster ? { type: 'img', src: poster } : null;
};
---
<Base title="Tier List — MAJO Codex" desc="Content-specific team guidance: Boss Training and the Tower of Anomalies.">
  <div class="wrap tier">
    <header class="thead">
      <h1 class="display">Tier List</h1>
      <p class="sub">Not an all-around ranking — team guidance for <b>current content and known walls</b>. Recommendations update with the rotation.</p>
    </header>

    <section class="mode">
      <h2 class="sec display">Boss Training</h2>
      {guides.bosses.map(b => (
        <article class="boss">
          <div class="boss-head">
            <div class="boss-art">
              {(() => { const m = bossMedia(b); return m
                ? (m.type === 'video'
                    ? <video class="boss-media" autoplay loop muted playsinline poster={m.poster || undefined}><source src={m.src} type={`video/${m.ext}`} /></video>
                    : <img class="boss-media" src={m.src} alt={b.name} />)
                : <span class="boss-ph" aria-hidden="true"></span>; })()}
            </div>
            <div class="boss-meta">
              <span class="mode-tag mono">{b.mode}</span>{b.upcoming && <span class="up-tag mono">Upcoming</span>}
              {b.full_name && <span class="boss-full">{b.full_name}</span>}
              <h3 class="boss-name">{b.name}</h3>
              <p class="boss-blurb">{b.blurb}</p>
              {b.source && <p class="boss-source mono">{b.source}</p>}
              {b.ranks && b.ranks.length > 0 && (
                <div class="ranks">
                  <span class="dl mono">HP by rank</span>
                  <div class="rank-grid mono">
                    {b.ranks.map(r => (
                      <div class="rank-cell">
                        <span class="rk">Rank {r.rank}{r.endless ? ' · Endless' : ''}</span>
                        <span class="rk-hp">{r.hp.toLocaleString()}</span>
                        <span class="rk-pw">rec {r.rec_power}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}
              <div class="type-row">
                <span class="tchip">{hasUi(`type_${lc(b.deals)}`) ? <img class="tic" src={ui(`type_${lc(b.deals)}`)} width="20" height="20" alt="" /> : <EyeBadge type={b.deals} size={20} title="" />} <span><b>{cap(b.deals)}</b> damage</span></span>
                <span class="tchip weak">{hasUi(`type_${lc(b.weak)}`) ? <img class="tic" src={ui(`type_${lc(b.weak)}`)} width="20" height="20" alt="" /> : <EyeBadge type={b.weak} size={20} title="" />} <span>Weak to <b>{cap(b.weak)}</b></span></span>
                {b.race && <span class="tchip"><span>Race: <b>{cap(b.race)}</b></span></span>}
              </div>
            </div>
          </div>

          <div class="boss-body">
            <div class="col">
              <span class="dl mono">Mechanics &amp; counters</span>
              {b.mechanics.map(m => (
                <div class="mech"><b>{m.name}.</b> {m.text}</div>
              ))}
              {b.control && b.control.length > 0 && (
                <>
                  <span class="dl mono" style="margin-top:16px">Control for the Wake-up Kickback</span>
                  <div class="recs">
                    {b.control.map(r => { const w = wById[r.witch_id]; return w ? (
                      <a class="rec" href={`${base}witch/${w.witch_id.toLowerCase()}`}>
                        <span class={`rdot is-${w.rarity}`}></span>
                        <span class="rname">{w.name}</span>
                        <span class="rnote">{r.note}</span>
                      </a>) : null; })}
                  </div>
                </>
              )}
              <span class="dl mono" style="margin-top:16px">Pro tips</span>
              <ul class="tips">{b.tips.map(t => <li>{t}</li>)}</ul>
            </div>
            <div class="col">
              {(b.recommended || []).length > 0 && (
                <>
                  <span class="dl mono">Recommended</span>
                  <div class="recs">
                    {b.recommended.map(r => {
                      const w = wById[r.witch_id];
                      return w ? (
                        <a class="rec" href={`${base}witch/${w.witch_id.toLowerCase()}`}>
                          <span class={`rdot is-${w.rarity}`}></span>
                          <span class="rname">{w.name}</span>
                          <span class="rnote">{r.note}</span>
                        </a>
                      ) : null;
                    })}
                  </div>
                </>
              )}
              <span class="dl mono" style="margin-top:16px">Auto — all {cap(b.weak)} dealers <span class="auto-note">(he's weak to {cap(b.weak)})</span></span>
              <div class="dealer-chips">
                {dealersByType(b.weak).map(w => (
                  <a class={`dchip2 is-${w.rarity}`} href={`${base}witch/${w.witch_id.toLowerCase()}`}>
                    <span class="dc-dot"></span>{w.name}<span class="dc-r mono">{w.rarity}</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </article>
      ))}
    </section>

    {guides.past_bosses && guides.past_bosses.length > 0 && (
      <section class="past">
        <details>
          <summary class="mono">Previous bosses ({guides.past_bosses.length})</summary>
          {guides.past_bosses.map(b => (
            <div class="past-boss">
              <h3 class="past-name">{b.name} <span class="mono past-tag">rotated out</span></h3>
              {b.mechanics && b.mechanics.map(m => <p class="past-mech"><b>{m.name}:</b> {m.text}</p>)}
            </div>
          ))}
        </details>
      </section>
    )}

    <section class="mode">
      <h2 class="sec display">{guides.tower.name}</h2>
      <div class="tower-empty">
        <p>{guides.tower.blurb}</p>
        <p class="hint mono">Tell me the specific hard floors and I'll add per-floor mechanics + comps.</p>
      </div>
    </section>
  </div>
</Base>

<style>
  .tier{padding:28px 24px 64px}
  .thead h1{font-size:clamp(2rem,5vw,3rem);margin:0 0 6px}
  .thead .sub{color:var(--ink-dim);max-width:60ch;margin:0 0 8px}
  .sec{font-size:1.5rem;margin:36px 0 16px}
  .mode-tag{font-size:.62rem;letter-spacing:.16em;text-transform:uppercase;color:var(--sigil)}
  .up-tag{margin-left:8px;font-size:.58rem;letter-spacing:.12em;text-transform:uppercase;color:#1c1406;background:linear-gradient(180deg,#ffe08a,var(--ssr));border-radius:6px;padding:2px 7px}
  .boss{background:var(--veil);border:1px solid var(--line);border-radius:var(--r);overflow:hidden}
  .boss-head{display:flex;gap:20px;padding:20px 22px;align-items:center;
    background:radial-gradient(600px 200px at 0% 0%, color-mix(in srgb,var(--mental,#d9c34a) 16%,transparent), transparent 70%)}
  .boss-art{width:120px;height:120px;flex-shrink:0;border-radius:12px;overflow:hidden;border:1px solid var(--line);background:var(--nightshade);display:grid;place-items:center}
  .boss-art img,.boss-art .boss-media{width:100%;height:100%;object-fit:cover;display:block}
  .boss-ph{width:56%;height:56%;border-radius:50%;background:radial-gradient(circle at 40% 35%, #5f6a3a, #23261a);opacity:.7}
  .boss-name{font-size:1.6rem;margin:4px 0 6px}
  .boss-blurb{color:var(--ink-dim);margin:0 0 10px;font-size:.92rem;max-width:56ch}
  .type-row{display:flex;flex-wrap:wrap;gap:10px}
  .tchip{display:inline-flex;align-items:center;gap:8px;background:rgba(20,16,32,.7);border:1px solid var(--line);
    border-radius:10px;padding:6px 11px;font-size:.86rem;color:var(--ink-dim)}
  .tchip b{color:var(--ink)}
  .tchip .tic{display:block}
  .boss-source{font-size:.66rem;color:var(--ink-faint);margin:0 0 10px}
  .tchip.weak{box-shadow:inset 0 0 0 1px color-mix(in srgb,#e0574b 40%,transparent)}
  .boss-body{display:grid;grid-template-columns:1fr 1fr;gap:22px;padding:20px 22px;border-top:1px solid var(--line)}
  .dl{display:block;font-size:.62rem;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-faint);margin-bottom:10px}
  .mech{background:var(--nightshade);border:1px solid var(--line);border-radius:9px;padding:11px 13px;margin-bottom:9px;font-size:.9rem;color:var(--ink-dim);line-height:1.5}
  .mech b{color:var(--ink)}
  .tips{margin:0;padding-left:18px;color:var(--ink-dim);font-size:.88rem;line-height:1.6}
  .recs{display:flex;flex-direction:column;gap:8px}
  .rec{display:grid;grid-template-columns:auto auto 1fr;align-items:baseline;gap:9px;text-decoration:none;
    background:var(--nightshade);border:1px solid var(--line);border-radius:9px;padding:10px 13px}
  .rec:hover{border-color:color-mix(in srgb,var(--sigil) 45%,var(--line))}
  .rdot{width:9px;height:9px;border-radius:50%;background:var(--ink-faint)}
  .rdot.is-SSR{background:var(--ssr)} .rdot.is-SR{background:var(--sr)}
  .rname{color:var(--ink);font-weight:600;font-size:.95rem}
  .rnote{color:var(--ink-faint);font-size:.82rem}
  .auto-note{color:var(--ink-faint);font-size:.66rem;letter-spacing:0;text-transform:none}
  .dealer-chips{display:flex;flex-wrap:wrap;gap:7px}
  .dchip2{display:inline-flex;align-items:center;gap:6px;text-decoration:none;font-size:.82rem;color:var(--ink-dim);
    background:var(--nightshade);border:1px solid var(--line);border-radius:999px;padding:5px 11px}
  .dchip2:hover{border-color:color-mix(in srgb,var(--sigil) 45%,var(--line));color:var(--ink)}
  .dc-dot{width:7px;height:7px;border-radius:50%;background:var(--ink-faint)}
  .dchip2.is-SSR .dc-dot{background:var(--ssr)} .dchip2.is-SR .dc-dot{background:var(--sr)}
  .dc-r{font-size:.6rem;color:var(--ink-faint)}
  .ranks{margin:12px 0 4px}
  .rank-grid{display:flex;flex-wrap:wrap;gap:8px;margin-top:6px}
  .rank-cell{display:flex;flex-direction:column;gap:1px;background:var(--nightshade);border:1px solid var(--line);
    border-radius:8px;padding:6px 11px;min-width:96px}
  .rank-cell .rk{font-size:.62rem;color:var(--ink-faint)}
  .rank-cell .rk-hp{font-size:.95rem;color:var(--ink);font-weight:700}
  .rank-cell .rk-pw{font-size:.6rem;color:var(--ink-faint)}
  .boss-full{display:block;font-size:.66rem;letter-spacing:.06em;color:var(--ink-faint);margin-top:2px}
  .past{padding:0 20px 40px;max-width:var(--maxw,1100px);margin:0 auto}
  .past summary{cursor:pointer;color:var(--ink-faint);font-size:.8rem;letter-spacing:.04em}
  .past-boss{margin:12px 0;padding:12px 14px;background:var(--veil);border:1px solid var(--line);border-radius:var(--r);opacity:.75}
  .past-name{margin:0 0 6px;font-size:1rem}
  .past-tag{font-size:.58rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-faint);border:1px solid var(--line);border-radius:5px;padding:1px 6px}
  .past-mech{font-size:.82rem;color:var(--ink-dim);margin:4px 0}
  .tower-empty{background:var(--veil);border:1px dashed var(--line);border-radius:var(--r);padding:22px;color:var(--ink-dim)}
  .auto-note{color:var(--ink-faint);font-size:.66rem;letter-spacing:0;text-transform:none}
  .dealer-chips{display:flex;flex-wrap:wrap;gap:7px}
  .dchip2{display:inline-flex;align-items:center;gap:6px;text-decoration:none;font-size:.82rem;color:var(--ink-dim);
    background:var(--nightshade);border:1px solid var(--line);border-radius:999px;padding:5px 11px}
  .dchip2:hover{border-color:color-mix(in srgb,var(--sigil) 45%,var(--line));color:var(--ink)}
  .dc-dot{width:7px;height:7px;border-radius:50%;background:var(--ink-faint)}
  .dchip2.is-SSR .dc-dot{background:var(--ssr)} .dchip2.is-SR .dc-dot{background:var(--sr)}
  .dc-r{font-size:.6rem;color:var(--ink-faint)}
  .tower-empty .hint{color:var(--ink-faint);font-size:.78rem;margin-bottom:0}
  @media(max-width:760px){ .boss-head{flex-direction:column;align-items:flex-start} .boss-body{grid-template-columns:1fr} }
</style>
